  "scripts": {
    "start": "node scripts/copy-pdf-worker.js && BROWSERSLIST_IGNORE_OLD_DATA=true craco start",
    "postinstall": "node scripts/copy-pdf-worker.js",
    "export-lessons": "python3 scripts/lesson_plans/fix_youtube_playlists.py && python3 scripts/lesson_plans/enrich_celtic_units.py && python3 scripts/lesson_plans/enrich_regional_units.py && python3 scripts/lesson_plans/sync_legacy_slots.py && python3 scripts/lesson_plans/export_lessons.py --manifest-scope app && python3 scripts/lesson_plans/export_feed_from_lessons.py",
    "build:lesson-preview": "vite build --config lesson-preview/vite.config.js",
    "dev:lesson-preview": "vite --config lesson-preview/vite.config.js",
    "serve:lesson-preview": "bash -c 'PORT=${PORT:-8766}; if [ ! -f lesson-preview/dist/index.html ]; then echo \"Missing build — run: npm run build:lesson-preview\"; exit 1; fi; exec python3 -m http.server \"$PORT\" --directory lesson-preview/dist'",
    "buildresources": "cd ./abcresources; nodejs ./rename_all.js; nodejs ./indexes_from_files.js",
    "package:youtube-helper": "node scripts/packageYoutubeHelperExtension.js",
    "build": "node scripts/copy-pdf-worker.js && npm run package:youtube-helper && craco build && bash scripts/embed-yogapp.sh && rm -rf ./static/ && cp -r ./build/* ./ && cp ./manifest.template.json ./manifest.json && node hackSw.js ",
    "embed:yogapp": "bash scripts/embed-yogapp.sh",
    "publish:everything": "bash scripts/publish-everything.sh",
    "build:web": "node scripts/copy-pdf-worker.js && npm run package:youtube-helper && craco build",
    "build:android": "npm run build:web && npx cap sync android",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:install": "bash scripts/install-android-debug.sh",
    "android:open": "npx cap open android",
    "android:run": "npm run build:android && cd android && ./gradlew assembleDebug",
    "build:chordlib": "node scripts/buildChordLib.js",
    "start:resolver": "cd local-resolver && docker compose up --build",
    "test": "node -r ./scripts/jest-preload-canvas-stub.js node_modules/@craco/craco/dist/scripts/test.js",
    "browser:seed-profile": "bash ./e2e/setup-debug-profile.sh",
    "browser:debug": "bash ./e2e/launch-debug-browser.sh",
    "check:react-warnings": "node scripts/check-react-warnings.js",
    "check:react-warnings:eslint": "node scripts/check-react-warnings.js --skip-browser",
    "test:playback": "react-scripts test --watchAll=false --testPathPattern=playback",
    "test:playback:router": "CI=1 npm test -- --watchAll=false --runInBand --testPathPattern=playbackRouter",
    "test:playback:router:e2e": "node e2e/playback-router-parity.js",
    "test:playback:router:all": "npm run test:playback:router && npm run test:playback:e2e && npm run test:playback:router:e2e",
    "test:playback:e2e": "node e2e/playback-smoke.js",
    "test:playback:e2e:headed": "HEADLESS=0 node e2e/playback-smoke.js",
    "test:playback:all": "npm run test:playback && npm run test:playback:e2e",
    "test:notation:e2e": "node e2e/notation-e2e.js",
    "test:notation:e2e:headed": "HEADLESS=0 node e2e/notation-e2e.js",
    "test:notation:all": "npm test -- --watchAll=false --testPathPattern=notation && npm run test:notation:e2e",
    "test:feed": "CI=1 npm test -- --watchAll=false --testPathPattern=feed",
    "test:feed:e2e": "node e2e/feed-e2e.js",
    "test:feed:e2e:headed": "HEADLESS=0 node e2e/feed-e2e.js",
    "test:feed:all": "npm run test:feed && npm run test:feed:e2e",
    "test:snapcast:e2e": "node e2e/snapcast-smoke.js",
    "generate:theory-examples": "PYTHONPATH=local-resolver python local-resolver/scripts/generate_theory_examples.py",
    "docs:musescore-handbook": "bash ./scripts/fetch-musescore-handbook.sh",
    "eject": "react-scripts eject",
    "serveextras": "ws --cors.origin=* -p 4000",
    "start:soundfonts": "ws --cors.origin=* -p 4000",
    "fetch:selection-soundfonts": "node scripts/fetch-selection-soundfonts.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "off",
      "use-isnan": "off",
      "no-useless-concat": "off",
      "no-unreachable": "off",
      "no-use-before-define": "off",
      "unicode-bom": "off",
      "no-cond-assign": "off",
      "no-self-assign": "off",
      "no-self-compare": "off",
      "no-const-assign": "off",
      "eqeqeq": "off",
      "no-redeclare": "off",
      "no-mixed-operators": "off",
      "no-useless-escape": "off",
      "array-callback-return": "off",
      "import/no-anonymous-default-export": "off",
      "no-new-wrappers": "off",
      "no-loop-func": "off",
      "default-case": "off",
      "no-throw-literal": "off",
      "strict": "off",
      "no-dupe-keys": "off",
      "testing-library/render-result-naming-convention": "off"
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^canvas$": "<rootDir>/src/__mocks__/canvas.js",
      "^youtube-player$": "<rootDir>/src/youtubePlayerSafeFactory.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "local-web-server": "^5.3.1",
    "vite": "^5.4.21",
    "worker-plugin": "^5.0.1",
    "workerize": "^0.1.8",
    "workerize-loader": "^1.3.0"
  }
}
