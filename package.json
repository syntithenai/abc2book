    "gulp": "^4.0.2",
    "gulp-inline-source": "^4.0.0",
    "gulp-replace": "^1.1.3",
    "html2canvas": "^1.4.1",
    "inline-worker": "^1.1.0",
    "is-online": "^10.0.0",
    "jquery": "^3.6.0",
    "jspdf": "^4.2.1",
    "jwt-decode": "^3.1.2",
