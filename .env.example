# Optional build-time media resolver URL (no trailing slash).
# Users can also set a resolver in Settings; manual URLs are tried first.
# If unset, the app tries http://localhost:8787, then public resolvers
# (https://peppertrees.syntithenai.com by default, plus any below).
# REACT_APP_MEDIA_PROXY_BASE=http://localhost:8787
# REACT_APP_PUBLIC_MEDIA_PROXY_URLS=https://resolver2.example.com,https://resolver3.example.com

# Optional: host soundfont MP3s locally via the resolver (npm run start:resolver).
# Requires the full midi-js-soundfonts mp3 tree; dev defaults to the paulrosen CDN unless set.
# REACT_APP_SOUNDFONT_BASE=http://localhost:8787/midi-js-soundfonts/abcjs

# Optional: when using npm start, load ABC/soundfont/scrape resources from the resolver.
# REACT_APP_RESOURCE_BASE=http://localhost:8787

# Optional: ABC synth volume multiplier (default 1.0; was 1.6 historically).
# REACT_APP_SOUNDFONT_VOLUME=0.8

# GoatCounter analytics count endpoint (e.g. https://abc2book.goatcounter.com/count).
# When set, anonymous usage events are sent via the GoatCounter script.
# Works with any DNS/host (no Cloudflare nameservers required).
# REACT_APP_GOATCOUNTER_URL=https://abc2book.goatcounter.com/count
# Force-enable analytics in development (defaults to on only in production builds).
# REACT_APP_ANALYTICS_ENABLED=true
