{
  "id": "forest-path-10",
  "voiceId": "zh-cn-xiaoxiao",
  "edgeVoice": "zh-CN-XiaoxiaoNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 591,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.184
    },
    {
      "index": 1,
      "text": "找到一种对你没有任何要求的姿势。",
      "file": "c001.ogg",
      "durationSec": 5.832
    },
    {
      "index": 2,
      "text": "坐下或躺下，根据需要提供任何支撑。",
      "file": "c002.ogg",
      "durationSec": 6.528
    },
    {
      "index": 3,
      "text": "让双手张开或柔软。",
      "file": "c003.ogg",
      "durationSec": 4.248
    },
    {
      "index": 4,
      "text": "让你的眼睛闭上，或者保持柔和的凝视。",
      "file": "c004.ogg",
      "durationSec": 6.864
    },
    {
      "index": 5,
      "text": "感受身体与地面接触的地方。",
      "file": "c005.ogg",
      "durationSec": 5.28
    },
    {
      "index": 6,
      "text": "脚跟、坐骨、后脑勺或脊柱的长度。",
      "file": "c006.ogg",
      "durationSec": 7.08
    },
    {
      "index": 7,
      "text": "现在没什么可以坚持的。",
      "file": "c007.ogg",
      "durationSec": 4.176
    },
    {
      "index": 8,
      "text": "通过鼻子缓慢吸气。",
      "file": "c008.ogg",
      "durationSec": 4.032
    },
    {
      "index": 9,
      "text": "感受空气的凉爽到来。",
      "file": "c009.ogg",
      "durationSec": 4.176
    },
    {
      "index": 10,
      "text": "并且呼气时间长一点。",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "感受呼气离开的温暖。",
      "file": "c011.ogg",
      "durationSec": 4.152
    },
    {
      "index": 12,
      "text": "再次。轻轻吸气。",
      "file": "c012.ogg",
      "durationSec": 4.968
    },
    {
      "index": 13,
      "text": "不紧不慢地呼气。",
      "file": "c013.ogg",
      "durationSec": 3.552
    },
    {
      "index": 14,
      "text": "让肩膀下降一点。",
      "file": "c014.ogg",
      "durationSec": 3.72
    },
    {
      "index": 15,
      "text": "让下巴松开。",
      "file": "c015.ogg",
      "durationSec": 3.096
    },
    {
      "index": 16,
      "text": "让肚子变软。",
      "file": "c016.ogg",
      "durationSec": 3.024
    },
    {
      "index": 17,
      "text": "保持三个安静的呼吸，就像它们本来的样子一样。",
      "file": "c017.ogg",
      "durationSec": 7.512
    },
    {
      "index": 18,
      "text": "吸气。到达。",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "呼气。定居。",
      "file": "c019.ogg",
      "durationSec": 4.224
    },
    {
      "index": 20,
      "text": "如果心走神，请善意地注意它，然后回到呼吸上。",
      "file": "c020.ogg",
      "durationSec": 8.112
    },
    {
      "index": 21,
      "text": "现在开始慢慢走进一片古老的森林。",
      "file": "c021.ogg",
      "durationSec": 6.312
    },
    {
      "index": 22,
      "text": "道路很软，布满了针叶和落叶。",
      "file": "c022.ogg",
      "durationSec": 5.52
    },
    {
      "index": 23,
      "text": "每一步都会发出轻微的声音，然后又归于寂静。",
      "file": "c023.ogg",
      "durationSec": 7.92
    },
    {
      "index": 24,
      "text": "阳光像温暖的丝带一样穿过高高的树枝。",
      "file": "c024.ogg",
      "durationSec": 6.96
    },
    {
      "index": 25,
      "text": "感受一缕阳光照在你的前臂上——突然的温和的热量。",
      "file": "c025.ogg",
      "durationSec": 8.52
    },
    {
      "index": 26,
      "text": "然后再次遮荫，凉爽、翠绿。",
      "file": "c026.ogg",
      "durationSec": 5.808
    },
    {
      "index": 27,
      "text": "微风吹动树冠。新鲜空气扑面而来。",
      "file": "c027.ogg",
      "durationSec": 7.632
    },
    {
      "index": 28,
      "text": "闻到树脂、潮湿的土壤和苔藓的干净甜味。",
      "file": "c028.ogg",
      "durationSec": 7.608
    },
    {
      "index": 29,
      "text": "暂停。将手掌放在粗糙的树皮上。",
      "file": "c029.ogg",
      "durationSec": 7.224
    },
    {
      "index": 30,
      "text": "感受树的寂静进入你的手中。",
      "file": "c030.ogg",
      "durationSec": 5.28
    },
    {
      "index": 31,
      "text": "继续深入。外界的声音逐渐消失。",
      "file": "c031.ogg",
      "durationSec": 6.864
    },
    {
      "index": 32,
      "text": "某处有一条小溪在用明亮的小音节说话。",
      "file": "c032.ogg",
      "durationSec": 6.696
    },
    {
      "index": 33,
      "text": "你跟着直到石头之间出现水。",
      "file": "c033.ogg",
      "durationSec": 5.088
    },
    {
      "index": 34,
      "text": "跪下。把手浸湿。凉爽的清晰度。",
      "file": "c034.ogg",
      "durationSec": 7.872
    },
    {
      "index": 35,
      "text": "溅一点在手腕上。清新唤醒肌肤。",
      "file": "c035.ogg",
      "durationSec": 7.056
    },
    {
      "index": 36,
      "text": "坐在一块平坦的岩石上，被狭窄的太阳光柱温暖着。",
      "file": "c036.ogg",
      "durationSec": 8.352
    },
    {
      "index": 37,
      "text": "感受坐骨和大腿后部的温暖。",
      "file": "c037.ogg",
      "durationSec": 5.376
    },
    {
      "index": 38,
      "text": "感受溪流清凉的气息拂过你的小腿。",
      "file": "c038.ogg",
      "durationSec": 6.264
    },
    {
      "index": 39,
      "text": "鸟儿鸣叫一次，然后又离开宁静。",
      "file": "c039.ogg",
      "durationSec": 5.712
    },
    {
      "index": 40,
      "text": "呼吸森林的清新。",
      "file": "c040.ogg",
      "durationSec": 3.672
    },
    {
      "index": 41,
      "text": "向你周围的病人躯干呼气。",
      "file": "c041.ogg",
      "durationSec": 4.752
    },
    {
      "index": 42,
      "text": "注意你的肩膀是如何在没有被询问的情况下下垂的。",
      "file": "c042.ogg",
      "durationSec": 7.968
    },
    {
      "index": 43,
      "text": "当无处可去时，下巴如何软化。",
      "file": "c043.ogg",
      "durationSec": 5.616
    },
    {
      "index": 44,
      "text": "准备好后站起来，再走远一点。",
      "file": "c044.ogg",
      "durationSec": 5.424
    },
    {
      "index": 45,
      "text": "蕨类植物用清凉的绿色指尖轻抚你的小腿。",
      "file": "c045.ogg",
      "durationSec": 7.752
    },
    {
      "index": 46,
      "text": "一片空地出现了——圆得像屏住呼吸一样。",
      "file": "c046.ogg",
      "durationSec": 6.648
    },
    {
      "index": 47,
      "text": "躺在深深的苔藓上。",
      "file": "c047.ogg",
      "durationSec": 3.984
    },
    {
      "index": 48,
      "text": "地球完全承受你的重量。",
      "file": "c048.ogg",
      "durationSec": 4.536
    },
    {
      "index": 49,
      "text": "过滤后的阳光照在脸上的温暖。",
      "file": "c049.ogg",
      "durationSec": 5.568
    },
    {
      "index": 50,
      "text": "脊椎上的苔藓清凉。",
      "file": "c050.ogg",
      "durationSec": 4.128
    },
    {
      "index": 51,
      "text": "微风来了，走了，又来了。",
      "file": "c051.ogg",
      "durationSec": 5.256
    },
    {
      "index": 52,
      "text": "保持被生活场所所拥抱的感觉。",
      "file": "c052.ogg",
      "durationSec": 5.928
    },
    {
      "index": 53,
      "text": "安全。安静的。无需努力即可归属。",
      "file": "c053.ogg",
      "durationSec": 8.448
    },
    {
      "index": 54,
      "text": "在这里缓慢地数五次呼吸，每一次呼吸都要轻柔一些。",
      "file": "c054.ogg",
      "durationSec": 8.76
    },
    {
      "index": 55,
      "text": "再次注意气味——绿色、潮湿、诚实。",
      "file": "c055.ogg",
      "durationSec": 7.224
    },
    {
      "index": 56,
      "text": "再次注意声音——几乎没有，但这已经足够了。",
      "file": "c056.ogg",
      "durationSec": 7.416
    },
    {
      "index": 57,
      "text": "如果有一个念头出现，就让它像溪流中的一片叶子一样漂流。",
      "file": "c057.ogg",
      "durationSec": 9.192
    },
    {
      "index": 58,
      "text": "无论阳光到达何处，肌肤都会恢复温暖。",
      "file": "c058.ogg",
      "durationSec": 7.104
    },
    {
      "index": 59,
      "text": "在那些温暖丝带之间的阴凉处恢复凉爽。",
      "file": "c059.ogg",
      "durationSec": 7.08
    },
    {
      "index": 60,
      "text": "你已经向内走得够远了。",
      "file": "c060.ogg",
      "durationSec": 4.2
    },
    {
      "index": 61,
      "text": "让三个缓慢的呼吸将其封印在体内。",
      "file": "c061.ogg",
      "durationSec": 6.408
    },
    {
      "index": 62,
      "text": "离开之前，再次站在溪边。",
      "file": "c062.ogg",
      "durationSec": 5.184
    },
    {
      "index": 63,
      "text": "观看清澈的水流围绕着石头。",
      "file": "c063.ogg",
      "durationSec": 5.496
    },
    {
      "index": 64,
      "text": "冷空气从移动表面上升。",
      "file": "c064.ogg",
      "durationSec": 4.776
    },
    {
      "index": 65,
      "text": "温暖的光线仍然发现你的前臂上有一条条带。",
      "file": "c065.ogg",
      "durationSec": 7.704
    },
    {
      "index": 66,
      "text": "如果你愿意的话，可以倒杯水，弄湿眉毛——在想象中，冷静而友善。",
      "file": "c066.ogg",
      "durationSec": 11.112
    },
    {
      "index": 67,
      "text": "森林没有鼓掌。它只是继续。",
      "file": "c067.ogg",
      "durationSec": 6.264
    },
    {
      "index": 68,
      "text": "那个延续就是一位老师。",
      "file": "c068.ogg",
      "durationSec": 4.704
    },
    {
      "index": 69,
      "text": "在心里沿着小路安静地走几步。",
      "file": "c069.ogg",
      "durationSec": 5.376
    },
    {
      "index": 70,
      "text": "脚下有针。声音柔和。软返回。",
      "file": "c070.ogg",
      "durationSec": 7.848
    },
    {
      "index": 71,
      "text": "然而空地的平静就像储存的阳光一样留在胸中。",
      "file": "c071.ogg",
      "durationSec": 8.4
    },
    {
      "index": 72,
      "text": "感受那里——胸骨后面的温暖。",
      "file": "c072.ogg",
      "durationSec": 5.376
    },
    {
      "index": 73,
      "text": "鼻孔里仍感觉清新。",
      "file": "c073.ogg",
      "durationSec": 4.2
    },
    {
      "index": 74,
      "text": "您可以将两者带入普通房间。",
      "file": "c074.ogg",
      "durationSec": 5.16
    },
    {
      "index": 75,
      "text": "最后一次透过树枝抬头仰望天空中的一枚硬币。",
      "file": "c075.ogg",
      "durationSec": 8.232
    },
    {
      "index": 76,
      "text": "够了。",
      "file": "c076.ogg",
      "durationSec": 1.992
    },
    {
      "index": 77,
      "text": "现在让故事休息一下，继续感受吧。",
      "file": "c077.ogg",
      "durationSec": 6.0
    },
    {
      "index": 78,
      "text": "呼吸这个地方的新鲜感。",
      "file": "c078.ogg",
      "durationSec": 4.488
    },
    {
      "index": 79,
      "text": "呼气，感受它的温暖和安静。",
      "file": "c079.ogg",
      "durationSec": 5.424
    },
    {
      "index": 80,
      "text": "吸气。",
      "file": "c080.ogg",
      "durationSec": 2.304
    },
    {
      "index": 81,
      "text": "呼气。",
      "file": "c081.ogg",
      "durationSec": 2.232
    },
    {
      "index": 82,
      "text": "再次。轻轻吸气。",
      "file": "c082.ogg",
      "durationSec": 4.968
    },
    {
      "index": 83,
      "text": "长长地呼气。",
      "file": "c083.ogg",
      "durationSec": 3.024
    },
    {
      "index": 84,
      "text": "感受这个想象世界的地面所支撑的身体。",
      "file": "c084.ogg",
      "durationSec": 7.104
    },
    {
      "index": 85,
      "text": "吸气。",
      "file": "c085.ogg",
      "durationSec": 2.304
    },
    {
      "index": 86,
      "text": "呼气。",
      "file": "c086.ogg",
      "durationSec": 2.232
    },
    {
      "index": 87,
      "text": "如果思绪游离，请回到皮肤上的温暖。",
      "file": "c087.ogg",
      "durationSec": 6.48
    },
    {
      "index": 88,
      "text": "或者冷却鼻子里的空气。",
      "file": "c088.ogg",
      "durationSec": 4.512
    },
    {
      "index": 89,
      "text": "吸气。",
      "file": "c089.ogg",
      "durationSec": 2.304
    },
    {
      "index": 90,
      "text": "呼气。",
      "file": "c090.ogg",
      "durationSec": 2.232
    },
    {
      "index": 91,
      "text": "吸气。",
      "file": "c091.ogg",
      "durationSec": 2.304
    },
    {
      "index": 92,
      "text": "呼气。",
      "file": "c092.ogg",
      "durationSec": 2.232
    },
    {
      "index": 93,
      "text": "留下来。软化。继续。",
      "file": "c093.ogg",
      "durationSec": 6.408
    },
    {
      "index": 94,
      "text": "吸气。",
      "file": "c094.ogg",
      "durationSec": 2.304
    },
    {
      "index": 95,
      "text": "呼气。",
      "file": "c095.ogg",
      "durationSec": 2.232
    },
    {
      "index": 96,
      "text": "又一个简单的循环。",
      "file": "c096.ogg",
      "durationSec": 3.816
    },
    {
      "index": 97,
      "text": "吸气。",
      "file": "c097.ogg",
      "durationSec": 2.304
    },
    {
      "index": 98,
      "text": "呼气。",
      "file": "c098.ogg",
      "durationSec": 2.232
    },
    {
      "index": 99,
      "text": "在这种感觉中再停留几个呼吸。",
      "file": "c099.ogg",
      "durationSec": 5.592
    },
    {
      "index": 100,
      "text": "温暖。柔软度。足够了。",
      "file": "c100.ogg",
      "durationSec": 6.768
    },
    {
      "index": 101,
      "text": "当你需要的时候你可以回到这个地方。",
      "file": "c101.ogg",
      "durationSec": 5.88
    },
    {
      "index": 102,
      "text": "它存在于你的注意力中，而不仅仅是想象中。",
      "file": "c102.ogg",
      "durationSec": 7.464
    },
    {
      "index": 103,
      "text": "开始加深呼吸。",
      "file": "c103.ogg",
      "durationSec": 3.456
    },
    {
      "index": 104,
      "text": "再次感受你周围的房间。",
      "file": "c104.ogg",
      "durationSec": 4.368
    },
    {
      "index": 105,
      "text": "动动手指。软化脚趾。",
      "file": "c105.ogg",
      "durationSec": 5.544
    },
    {
      "index": 106,
      "text": "准备好后，睁开眼睛。",
      "file": "c106.ogg",
      "durationSec": 4.44
    },
    {
      "index": 107,
      "text": "再轻松地吸一口气。",
      "file": "c107.ogg",
      "durationSec": 3.96
    },
    {
      "index": 108,
      "text": "将这种平静带入接下来发生的一切。",
      "file": "c108.ogg",
      "durationSec": 6.24
    }
  ]
}
