{
  "id": "canyon-gold-10",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 608,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找到一种对你没有任何要求的姿势。",
      "file": "c001.ogg",
      "durationSec": 5.952
    },
    {
      "index": 2,
      "text": "坐下或躺下，根据需要提供任何支撑。",
      "file": "c002.ogg",
      "durationSec": 7.296
    },
    {
      "index": 3,
      "text": "让双手张开或柔软。",
      "file": "c003.ogg",
      "durationSec": 4.728
    },
    {
      "index": 4,
      "text": "让你的眼睛闭上，或者保持柔和的凝视。",
      "file": "c004.ogg",
      "durationSec": 6.768
    },
    {
      "index": 5,
      "text": "感受身体与地面接触的地方。",
      "file": "c005.ogg",
      "durationSec": 5.4
    },
    {
      "index": 6,
      "text": "脚跟、坐骨、后脑勺或脊柱的长度。",
      "file": "c006.ogg",
      "durationSec": 8.016
    },
    {
      "index": 7,
      "text": "现在没什么可以坚持的。",
      "file": "c007.ogg",
      "durationSec": 4.344
    },
    {
      "index": 8,
      "text": "通过鼻子缓慢吸气。",
      "file": "c008.ogg",
      "durationSec": 4.632
    },
    {
      "index": 9,
      "text": "感受空气的凉爽到来。",
      "file": "c009.ogg",
      "durationSec": 4.584
    },
    {
      "index": 10,
      "text": "并且呼气时间长一点。",
      "file": "c010.ogg",
      "durationSec": 4.512
    },
    {
      "index": 11,
      "text": "感受呼气离开的温暖。",
      "file": "c011.ogg",
      "durationSec": 4.416
    },
    {
      "index": 12,
      "text": "再次。轻轻吸气。",
      "file": "c012.ogg",
      "durationSec": 5.4
    },
    {
      "index": 13,
      "text": "不紧不慢地呼气。",
      "file": "c013.ogg",
      "durationSec": 3.744
    },
    {
      "index": 14,
      "text": "让肩膀下降一点。",
      "file": "c014.ogg",
      "durationSec": 3.84
    },
    {
      "index": 15,
      "text": "让下巴松开。",
      "file": "c015.ogg",
      "durationSec": 3.264
    },
    {
      "index": 16,
      "text": "让肚子变软。",
      "file": "c016.ogg",
      "durationSec": 3.48
    },
    {
      "index": 17,
      "text": "保持三个安静的呼吸，就像它们本来的样子一样。",
      "file": "c017.ogg",
      "durationSec": 7.296
    },
    {
      "index": 18,
      "text": "吸气。到达。",
      "file": "c018.ogg",
      "durationSec": 4.824
    },
    {
      "index": 19,
      "text": "呼气。定居。",
      "file": "c019.ogg",
      "durationSec": 4.848
    },
    {
      "index": 20,
      "text": "如果心走神，请善意地注意它，然后回到呼吸上。",
      "file": "c020.ogg",
      "durationSec": 8.472
    },
    {
      "index": 21,
      "text": "想象一下，一条宽阔的峡谷被涂成了淡金色和玫瑰色。",
      "file": "c021.ogg",
      "durationSec": 9.432
    },
    {
      "index": 22,
      "text": "现在是下午晚些时候。光线很慷慨。",
      "file": "c022.ogg",
      "durationSec": 8.256
    },
    {
      "index": 23,
      "text": "一整天都沐浴在阳光下的石头散发着温暖。",
      "file": "c023.ogg",
      "durationSec": 7.464
    },
    {
      "index": 24,
      "text": "感受小腿和手背上的辐射热。",
      "file": "c024.ogg",
      "durationSec": 5.376
    },
    {
      "index": 25,
      "text": "干燥清新的微风沿着峡谷底部吹过。",
      "file": "c025.ogg",
      "durationSec": 6.576
    },
    {
      "index": 26,
      "text": "它可以让你的脸凉爽，但又不会失去温暖的舒适感。",
      "file": "c026.ogg",
      "durationSec": 7.824
    },
    {
      "index": 27,
      "text": "你走在安静的墙壁之间的沙路上。",
      "file": "c027.ogg",
      "durationSec": 5.76
    },
    {
      "index": 28,
      "text": "脚步声低语。回声很柔和，几乎是礼貌的。",
      "file": "c028.ogg",
      "durationSec": 8.376
    },
    {
      "index": 29,
      "text": "闻到阳光烘烤过的泥土、鼠尾草和干净灰尘的味道。",
      "file": "c029.ogg",
      "durationSec": 9.384
    },
    {
      "index": 30,
      "text": "将手掌放在光滑的石头上。",
      "file": "c030.ogg",
      "durationSec": 5.184
    },
    {
      "index": 31,
      "text": "感受那里储存的日光——稳定、耐心的热量。",
      "file": "c031.ogg",
      "durationSec": 7.944
    },
    {
      "index": 32,
      "text": "一条遮阳带为几步带来凉爽。",
      "file": "c032.ogg",
      "durationSec": 5.376
    },
    {
      "index": 33,
      "text": "然后阳光再次照在你的肩膀上，像披肩一样温暖。",
      "file": "c033.ogg",
      "durationSec": 7.896
    },
    {
      "index": 34,
      "text": "你来到了一个峡谷开口的地方。",
      "file": "c034.ogg",
      "durationSec": 5.064
    },
    {
      "index": 35,
      "text": "坐在一块平坦的岩石上，仍然保持着金色的温暖。",
      "file": "c035.ogg",
      "durationSec": 7.944
    },
    {
      "index": 36,
      "text": "感觉它通过你的座位和脊柱上升。",
      "file": "c036.ogg",
      "durationSec": 6.096
    },
    {
      "index": 37,
      "text": "每次吸气都能感受到高原上更新鲜的空气。",
      "file": "c037.ogg",
      "durationSec": 8.04
    },
    {
      "index": 38,
      "text": "远方的上方，一只鹰缓慢地盘旋，不慌不忙。",
      "file": "c038.ogg",
      "durationSec": 8.256
    },
    {
      "index": 39,
      "text": "你借用了那种从容不迫的品质。",
      "file": "c039.ogg",
      "durationSec": 5.592
    },
    {
      "index": 40,
      "text": "呼吸长长。身体沉重。心胸宽阔，如墙缝间的天空。",
      "file": "c040.ogg",
      "durationSec": 11.832
    },
    {
      "index": 41,
      "text": "当太阳落山时，看着影子爬上远处的悬崖。",
      "file": "c041.ogg",
      "durationSec": 8.04
    },
    {
      "index": 42,
      "text": "颜色加深。温暖会减弱，但不会消失。",
      "file": "c042.ogg",
      "durationSec": 8.52
    },
    {
      "index": 43,
      "text": "微风现在闻起来凉爽一些，带着傍晚的清新气息。",
      "file": "c043.ogg",
      "durationSec": 8.112
    },
    {
      "index": 44,
      "text": "用双臂抱住自己一会儿。",
      "file": "c044.ogg",
      "durationSec": 4.8
    },
    {
      "index": 45,
      "text": "自己身体的温暖。石头的温暖。足够的。",
      "file": "c045.ogg",
      "durationSec": 8.688
    },
    {
      "index": 46,
      "text": "小心地躺下来，看着第一颗安静的星星。",
      "file": "c046.ogg",
      "durationSec": 6.672
    },
    {
      "index": 47,
      "text": "峡谷托着你，就像杯状的手托着水一样——轻轻地，不会溢出。",
      "file": "c047.ogg",
      "durationSec": 10.488
    },
    {
      "index": 48,
      "text": "安息在那种被控制的感觉中。",
      "file": "c048.ogg",
      "durationSec": 4.8
    },
    {
      "index": 49,
      "text": "注意最后的热量从岩石上升到冷却空气中。",
      "file": "c049.ogg",
      "durationSec": 8.112
    },
    {
      "index": 50,
      "text": "请注意，微风现在充满了傍晚、灰尘和鼠尾草的味道。",
      "file": "c050.ogg",
      "durationSec": 10.368
    },
    {
      "index": 51,
      "text": "你的呼吸放慢了，以适应周围的安静。",
      "file": "c051.ogg",
      "durationSec": 6.408
    },
    {
      "index": 52,
      "text": "如果眉毛仍然紧张，请用金色的光芒将其软化。",
      "file": "c052.ogg",
      "durationSec": 8.496
    },
    {
      "index": 53,
      "text": "如果鹰的下巴很紧，那么当鹰轻松转动时，让它放松。",
      "file": "c053.ogg",
      "durationSec": 8.808
    },
    {
      "index": 54,
      "text": "多呆几次温暖的石头和新鲜的空气。",
      "file": "c054.ogg",
      "durationSec": 6.288
    },
    {
      "index": 55,
      "text": "你没有迟到。你在这里。",
      "file": "c055.ogg",
      "durationSec": 5.736
    },
    {
      "index": 56,
      "text": "沿着峡谷壁之间温暖的沙子再走几步。",
      "file": "c056.ogg",
      "durationSec": 7.224
    },
    {
      "index": 57,
      "text": "你的影子拉得很长，无忧无虑。",
      "file": "c057.ogg",
      "durationSec": 6.072
    },
    {
      "index": 58,
      "text": "再次将双手掌放在石头上。",
      "file": "c058.ogg",
      "durationSec": 5.184
    },
    {
      "index": 59,
      "text": "热量进入手中就像一种你不需要赢得的祝福。",
      "file": "c059.ogg",
      "durationSec": 8.16
    },
    {
      "index": 60,
      "text": "微风吹过你的头发，带来凉爽。",
      "file": "c060.ogg",
      "durationSec": 5.664
    },
    {
      "index": 61,
      "text": "鼠尾草香气。尘埃气味。阳光的气味。",
      "file": "c061.ogg",
      "durationSec": 9.336
    },
    {
      "index": 62,
      "text": "坐下。膝盖软了。脊椎轻松。",
      "file": "c062.ogg",
      "durationSec": 8.16
    },
    {
      "index": 63,
      "text": "手表颜色从金色加深到玫瑰色。",
      "file": "c063.ogg",
      "durationSec": 6.192
    },
    {
      "index": 64,
      "text": "温暖变得柔和。新鲜度增加。平衡依然存在。",
      "file": "c064.ogg",
      "durationSec": 10.176
    },
    {
      "index": 65,
      "text": "这就是晚上教神经系统降档的方式。",
      "file": "c065.ogg",
      "durationSec": 6.456
    },
    {
      "index": 66,
      "text": "毫不费力地借用教训。",
      "file": "c066.ogg",
      "durationSec": 4.344
    },
    {
      "index": 67,
      "text": "石头的三个呼吸。",
      "file": "c067.ogg",
      "durationSec": 3.864
    },
    {
      "index": 68,
      "text": "三为天。",
      "file": "c068.ogg",
      "durationSec": 3.312
    },
    {
      "index": 69,
      "text": "三是为了你自己身体里安静的动物，休息。",
      "file": "c069.ogg",
      "durationSec": 7.608
    },
    {
      "index": 70,
      "text": "现在让故事休息一下，继续感受吧。",
      "file": "c070.ogg",
      "durationSec": 6.36
    },
    {
      "index": 71,
      "text": "呼吸这个地方的新鲜感。",
      "file": "c071.ogg",
      "durationSec": 4.536
    },
    {
      "index": 72,
      "text": "呼气，感受它的温暖和安静。",
      "file": "c072.ogg",
      "durationSec": 6.168
    },
    {
      "index": 73,
      "text": "吸气。",
      "file": "c073.ogg",
      "durationSec": 2.832
    },
    {
      "index": 74,
      "text": "呼气。",
      "file": "c074.ogg",
      "durationSec": 2.88
    },
    {
      "index": 75,
      "text": "再次。轻轻吸气。",
      "file": "c075.ogg",
      "durationSec": 5.4
    },
    {
      "index": 76,
      "text": "长长地呼气。",
      "file": "c076.ogg",
      "durationSec": 3.48
    },
    {
      "index": 77,
      "text": "感受这个想象世界的地面所支撑的身体。",
      "file": "c077.ogg",
      "durationSec": 6.984
    },
    {
      "index": 78,
      "text": "吸气。",
      "file": "c078.ogg",
      "durationSec": 2.832
    },
    {
      "index": 79,
      "text": "呼气。",
      "file": "c079.ogg",
      "durationSec": 2.88
    },
    {
      "index": 80,
      "text": "如果思绪游离，请回到皮肤上的温暖。",
      "file": "c080.ogg",
      "durationSec": 6.72
    },
    {
      "index": 81,
      "text": "或者冷却鼻子里的空气。",
      "file": "c081.ogg",
      "durationSec": 4.416
    },
    {
      "index": 82,
      "text": "吸气。",
      "file": "c082.ogg",
      "durationSec": 2.832
    },
    {
      "index": 83,
      "text": "呼气。",
      "file": "c083.ogg",
      "durationSec": 2.88
    },
    {
      "index": 84,
      "text": "吸气。",
      "file": "c084.ogg",
      "durationSec": 2.832
    },
    {
      "index": 85,
      "text": "呼气。",
      "file": "c085.ogg",
      "durationSec": 2.88
    },
    {
      "index": 86,
      "text": "留下来。软化。继续。",
      "file": "c086.ogg",
      "durationSec": 6.96
    },
    {
      "index": 87,
      "text": "吸气。",
      "file": "c087.ogg",
      "durationSec": 2.832
    },
    {
      "index": 88,
      "text": "呼气。",
      "file": "c088.ogg",
      "durationSec": 2.88
    },
    {
      "index": 89,
      "text": "又一个简单的循环。",
      "file": "c089.ogg",
      "durationSec": 4.104
    },
    {
      "index": 90,
      "text": "吸气。",
      "file": "c090.ogg",
      "durationSec": 2.832
    },
    {
      "index": 91,
      "text": "呼气。",
      "file": "c091.ogg",
      "durationSec": 2.88
    },
    {
      "index": 92,
      "text": "在这种感觉中再停留几个呼吸。",
      "file": "c092.ogg",
      "durationSec": 6.072
    },
    {
      "index": 93,
      "text": "温暖。柔软度。足够了。",
      "file": "c093.ogg",
      "durationSec": 7.296
    },
    {
      "index": 94,
      "text": "当你需要的时候你可以回到这个地方。",
      "file": "c094.ogg",
      "durationSec": 6.0
    },
    {
      "index": 95,
      "text": "它存在于你的注意力中，而不仅仅是想象中。",
      "file": "c095.ogg",
      "durationSec": 7.44
    },
    {
      "index": 96,
      "text": "开始加深呼吸。",
      "file": "c096.ogg",
      "durationSec": 3.792
    },
    {
      "index": 97,
      "text": "再次感受你周围的房间。",
      "file": "c097.ogg",
      "durationSec": 4.56
    },
    {
      "index": 98,
      "text": "动动手指。软化脚趾。",
      "file": "c098.ogg",
      "durationSec": 6.12
    },
    {
      "index": 99,
      "text": "准备好后，睁开眼睛。",
      "file": "c099.ogg",
      "durationSec": 4.728
    },
    {
      "index": 100,
      "text": "再轻松地吸一口气。",
      "file": "c100.ogg",
      "durationSec": 4.08
    },
    {
      "index": 101,
      "text": "将这种平静带入接下来发生的一切。",
      "file": "c101.ogg",
      "durationSec": 6.6
    }
  ]
}
