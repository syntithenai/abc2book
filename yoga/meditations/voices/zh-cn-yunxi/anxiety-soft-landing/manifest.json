{
  "id": "anxiety-soft-landing",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 135,
  "chunks": [
    {
      "index": 0,
      "text": "如果您感到活跃或担心，欢迎您来到这里。",
      "file": "c000.ogg",
      "durationSec": 7.08
    },
    {
      "index": 1,
      "text": "你还不需要感到平静。",
      "file": "c001.ogg",
      "durationSec": 4.008
    },
    {
      "index": 2,
      "text": "跟着走吧。",
      "file": "c002.ogg",
      "durationSec": 3.168
    },
    {
      "index": 3,
      "text": "如果可以的话，将双脚放在地板上。",
      "file": "c003.ogg",
      "durationSec": 6.48
    },
    {
      "index": 4,
      "text": "感受接触。高跟鞋。脚掌。脚趾。",
      "file": "c004.ogg",
      "durationSec": 9.888
    },
    {
      "index": 5,
      "text": "轻轻按下。注意来自地面的推力。",
      "file": "c005.ogg",
      "durationSec": 6.864
    },
    {
      "index": 6,
      "text": "说出你能看到的五件事。",
      "file": "c006.ogg",
      "durationSec": 4.392
    },
    {
      "index": 7,
      "text": "静静地。不着急。",
      "file": "c007.ogg",
      "durationSec": 5.232
    },
    {
      "index": 8,
      "text": "说出四种你可以触摸的东西。",
      "file": "c008.ogg",
      "durationSec": 5.808
    },
    {
      "index": 9,
      "text": "衣服。椅子。皮肤上有空气。",
      "file": "c009.ogg",
      "durationSec": 7.416
    },
    {
      "index": 10,
      "text": "说出三种声音，近的或远的。",
      "file": "c010.ogg",
      "durationSec": 5.688
    },
    {
      "index": 11,
      "text": "说出两种气味，或者只是注意空气中的气味。",
      "file": "c011.ogg",
      "durationSec": 7.536
    },
    {
      "index": 12,
      "text": "说出一种味道，或者嘴里的感觉。",
      "file": "c012.ogg",
      "durationSec": 5.688
    },
    {
      "index": 13,
      "text": "你在这里。在这个身体里。在这个房间里。",
      "file": "c013.ogg",
      "durationSec": 8.616
    },
    {
      "index": 14,
      "text": "现在吸气四次。",
      "file": "c014.ogg",
      "durationSec": 3.888
    },
    {
      "index": 15,
      "text": "轻轻握住两个人。",
      "file": "c015.ogg",
      "durationSec": 3.72
    },
    {
      "index": 16,
      "text": "六人出局。",
      "file": "c016.ogg",
      "durationSec": 3.336
    },
    {
      "index": 17,
      "text": "如果你愿意的话再来一次。",
      "file": "c017.ogg",
      "durationSec": 5.04
    },
    {
      "index": 18,
      "text": "将手放在胸部或腹部。",
      "file": "c018.ogg",
      "durationSec": 4.896
    },
    {
      "index": 19,
      "text": "感受手下的运动。",
      "file": "c019.ogg",
      "durationSec": 3.888
    },
    {
      "index": 20,
      "text": "焦虑可能仍然存在。这是允许的。",
      "file": "c020.ogg",
      "durationSec": 7.176
    },
    {
      "index": 21,
      "text": "你让神经系统软着陆了。",
      "file": "c021.ogg",
      "durationSec": 4.944
    },
    {
      "index": 22,
      "text": "再吸一口气。",
      "file": "c022.ogg",
      "durationSec": 3.432
    },
    {
      "index": 23,
      "text": "准备好后，睁开眼睛，继续新的一天。",
      "file": "c023.ogg",
      "durationSec": 7.224
    }
  ]
}
