{
  "id": "lakeside-dawn-5",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 356,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.736
    },
    {
      "index": 2,
      "text": "让你的双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "让你的眼睛闭上，或者软化你的目光。",
      "file": "c003.ogg",
      "durationSec": 6.456
    },
    {
      "index": 4,
      "text": "注意你所承受的身体重量。",
      "file": "c004.ogg",
      "durationSec": 5.256
    },
    {
      "index": 5,
      "text": "通过鼻子缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 4.632
    },
    {
      "index": 6,
      "text": "并且呼气时间更长、更轻松。",
      "file": "c006.ogg",
      "durationSec": 7.104
    },
    {
      "index": 7,
      "text": "再次。轻轻吸气。",
      "file": "c007.ogg",
      "durationSec": 5.4
    },
    {
      "index": 8,
      "text": "轻轻呼气。",
      "file": "c008.ogg",
      "durationSec": 3.408
    },
    {
      "index": 9,
      "text": "如果思绪游离，那也没关系。回到呼吸。",
      "file": "c009.ogg",
      "durationSec": 7.968
    },
    {
      "index": 10,
      "text": "想象一下自己在黎明时分站在平静的湖边。",
      "file": "c010.ogg",
      "durationSec": 8.16
    },
    {
      "index": 11,
      "text": "水面托起淡银色的天空。",
      "file": "c011.ogg",
      "durationSec": 4.848
    },
    {
      "index": 12,
      "text": "凉爽的空气拂过你的脸颊，带来清新的感觉。",
      "file": "c012.ogg",
      "durationSec": 8.16
    },
    {
      "index": 13,
      "text": "柔软的阳光开始温暖你的肩膀。",
      "file": "c013.ogg",
      "durationSec": 5.928
    },
    {
      "index": 14,
      "text": "感觉温暖慢慢地蔓延到你的背上。",
      "file": "c014.ogg",
      "durationSec": 5.568
    },
    {
      "index": 15,
      "text": "你走近了一步。柔软的沙子踩在你的脚下。",
      "file": "c015.ogg",
      "durationSec": 8.16
    },
    {
      "index": 16,
      "text": "将指尖浸入水中。凉爽的。清除。",
      "file": "c016.ogg",
      "durationSec": 8.784
    },
    {
      "index": 17,
      "text": "涟漪向外传播并消失。",
      "file": "c017.ogg",
      "durationSec": 4.752
    },
    {
      "index": 18,
      "text": "微风中带着淡淡的水草和早晨的味道。",
      "file": "c018.ogg",
      "durationSec": 7.584
    },
    {
      "index": 19,
      "text": "听着。几乎什么都没有。一只遥远的鸟。你自己的呼吸。",
      "file": "c019.ogg",
      "durationSec": 11.712
    },
    {
      "index": 20,
      "text": "坐在一块光滑的石头上，被冉冉升起的光线加热得刚刚好。",
      "file": "c020.ogg",
      "durationSec": 9.384
    },
    {
      "index": 21,
      "text": "感受脚下石头安静的热量。",
      "file": "c021.ogg",
      "durationSec": 5.184
    },
    {
      "index": 22,
      "text": "感受进入肺部的新鲜空气。",
      "file": "c022.ogg",
      "durationSec": 5.472
    },
    {
      "index": 23,
      "text": "湖水呈现出柔和的粉红色和金色。",
      "file": "c023.ogg",
      "durationSec": 6.648
    },
    {
      "index": 24,
      "text": "你会看到光线在表面移动，就像缓慢的呼吸一样。",
      "file": "c024.ogg",
      "durationSec": 8.88
    },
    {
      "index": 25,
      "text": "一条鱼升起，环变宽，然后镜子又回来了。",
      "file": "c025.ogg",
      "durationSec": 8.232
    },
    {
      "index": 26,
      "text": "温暖在你闭上的眼睑上。",
      "file": "c026.ogg",
      "durationSec": 5.016
    },
    {
      "index": 27,
      "text": "手背凉凉的。",
      "file": "c027.ogg",
      "durationSec": 3.768
    },
    {
      "index": 28,
      "text": "远处的某个地方，一根船绳在木头上发出滴答声。",
      "file": "c028.ogg",
      "durationSec": 8.616
    },
    {
      "index": 29,
      "text": "然后又是一片寂静，宽广而友善。",
      "file": "c029.ogg",
      "durationSec": 6.456
    },
    {
      "index": 30,
      "text": "吸入清晨的凉爽。呼气到开放水域。",
      "file": "c030.ogg",
      "durationSec": 7.416
    },
    {
      "index": 31,
      "text": "平静就像薄雾从水中升起的方式一样平静——轻轻地、完全地。",
      "file": "c031.ogg",
      "durationSec": 11.112
    },
    {
      "index": 32,
      "text": "你可以在这片安静中占据一席之地。",
      "file": "c032.ogg",
      "durationSec": 6.504
    },
    {
      "index": 33,
      "text": "又呼吸了一口黎明的味道。",
      "file": "c033.ogg",
      "durationSec": 4.584
    },
    {
      "index": 34,
      "text": "再看看水面上银色的光路。",
      "file": "c034.ogg",
      "durationSec": 4.92
    },
    {
      "index": 35,
      "text": "用温柔的目光追随它，走向远方的海岸。",
      "file": "c035.ogg",
      "durationSec": 7.416
    },
    {
      "index": 36,
      "text": "那边的树木因远处和晨雾而呈蓝色。",
      "file": "c036.ogg",
      "durationSec": 6.984
    },
    {
      "index": 37,
      "text": "随着太阳的升起，你的肩膀上渐渐变得温暖起来。",
      "file": "c037.ogg",
      "durationSec": 8.592
    },
    {
      "index": 38,
      "text": "微风保持清新——湖水吹来，干净。",
      "file": "c038.ogg",
      "durationSec": 6.984
    },
    {
      "index": 39,
      "text": "让清新的感觉冲洗心灵，就像光线冲洗表面一样。",
      "file": "c039.ogg",
      "durationSec": 8.904
    },
    {
      "index": 40,
      "text": "一起再坐三口温暖和凉爽的空气。",
      "file": "c040.ogg",
      "durationSec": 6.312
    },
    {
      "index": 41,
      "text": "现在独自在呼吸中休息一会儿。",
      "file": "c041.ogg",
      "durationSec": 5.256
    },
    {
      "index": 42,
      "text": "慢慢吸气。",
      "file": "c042.ogg",
      "durationSec": 3.216
    },
    {
      "index": 43,
      "text": "慢慢呼气。",
      "file": "c043.ogg",
      "durationSec": 3.24
    },
    {
      "index": 44,
      "text": "吸气。",
      "file": "c044.ogg",
      "durationSec": 2.832
    },
    {
      "index": 45,
      "text": "呼气。",
      "file": "c045.ogg",
      "durationSec": 2.88
    },
    {
      "index": 46,
      "text": "身体哪里温暖，哪里就感觉温暖。",
      "file": "c046.ogg",
      "durationSec": 6.264
    },
    {
      "index": 47,
      "text": "空气凉爽的地方都会感到凉爽。",
      "file": "c047.ogg",
      "durationSec": 5.664
    },
    {
      "index": 48,
      "text": "吸气。",
      "file": "c048.ogg",
      "durationSec": 2.832
    },
    {
      "index": 49,
      "text": "呼气。",
      "file": "c049.ogg",
      "durationSec": 2.88
    },
    {
      "index": 50,
      "text": "无处可去。没什么可修复的。",
      "file": "c050.ogg",
      "durationSec": 6.672
    },
    {
      "index": 51,
      "text": "吸气。",
      "file": "c051.ogg",
      "durationSec": 2.832
    },
    {
      "index": 52,
      "text": "呼气。",
      "file": "c052.ogg",
      "durationSec": 2.88
    },
    {
      "index": 53,
      "text": "在这里休息一下，安静地呼吸几口气。",
      "file": "c053.ogg",
      "durationSec": 6.72
    },
    {
      "index": 54,
      "text": "要知道你可以随时回到这个地方。",
      "file": "c054.ogg",
      "durationSec": 6.312
    },
    {
      "index": 55,
      "text": "当你准备好后，加深呼吸。",
      "file": "c055.ogg",
      "durationSec": 5.4
    },
    {
      "index": 56,
      "text": "摆动手指和脚趾。",
      "file": "c056.ogg",
      "durationSec": 4.32
    },
    {
      "index": 57,
      "text": "轻轻地睁开眼睛。",
      "file": "c057.ogg",
      "durationSec": 3.936
    },
    {
      "index": 58,
      "text": "随身携带一点这种平静。",
      "file": "c058.ogg",
      "durationSec": 4.488
    }
  ]
}
