{
  "id": "breath-awareness",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 117,
  "chunks": [
    {
      "index": 0,
      "text": "保持稳定的姿势。",
      "file": "c000.ogg",
      "durationSec": 3.912
    },
    {
      "index": 1,
      "text": "脊柱高但不僵硬。",
      "file": "c001.ogg",
      "durationSec": 4.368
    },
    {
      "index": 2,
      "text": "将注意力集中在已经存在的呼吸上。",
      "file": "c002.ogg",
      "durationSec": 6.12
    },
    {
      "index": 3,
      "text": "暂时不要改变它。就看吧。",
      "file": "c003.ogg",
      "durationSec": 5.952
    },
    {
      "index": 4,
      "text": "感受鼻孔处吸气的清凉。",
      "file": "c004.ogg",
      "durationSec": 5.16
    },
    {
      "index": 5,
      "text": "感受呼气的温暖。",
      "file": "c005.ogg",
      "durationSec": 3.984
    },
    {
      "index": 6,
      "text": "或者注意腹部的起伏。",
      "file": "c006.ogg",
      "durationSec": 4.152
    },
    {
      "index": 7,
      "text": "选择一个地方来休息你的注意力。",
      "file": "c007.ogg",
      "durationSec": 5.568
    },
    {
      "index": 8,
      "text": "当心走神时，请返回。",
      "file": "c008.ogg",
      "durationSec": 5.328
    },
    {
      "index": 9,
      "text": "没有判断力。就回来吧。",
      "file": "c009.ogg",
      "durationSec": 5.952
    },
    {
      "index": 10,
      "text": "现在，如果感觉很容易，请计算软周期。",
      "file": "c010.ogg",
      "durationSec": 7.872
    },
    {
      "index": 11,
      "text": "吸气。一。",
      "file": "c011.ogg",
      "durationSec": 4.632
    },
    {
      "index": 12,
      "text": "呼气。一。",
      "file": "c012.ogg",
      "durationSec": 4.68
    },
    {
      "index": 13,
      "text": "吸气。二。",
      "file": "c013.ogg",
      "durationSec": 4.68
    },
    {
      "index": 14,
      "text": "呼气。二。",
      "file": "c014.ogg",
      "durationSec": 4.728
    },
    {
      "index": 15,
      "text": "继续到五，然后再从一开始。",
      "file": "c015.ogg",
      "durationSec": 5.472
    },
    {
      "index": 16,
      "text": "如果你数不清了，请以善意重新开始。",
      "file": "c016.ogg",
      "durationSec": 6.528
    },
    {
      "index": 17,
      "text": "回归就是修行。",
      "file": "c017.ogg",
      "durationSec": 3.888
    },
    {
      "index": 18,
      "text": "让呼吸自然。没有压力。",
      "file": "c018.ogg",
      "durationSec": 6.0
    },
    {
      "index": 19,
      "text": "又沉默了几个循环。",
      "file": "c019.ogg",
      "durationSec": 4.056
    },
    {
      "index": 20,
      "text": "释放计数。",
      "file": "c020.ogg",
      "durationSec": 3.528
    },
    {
      "index": 21,
      "text": "在开放的意识中休息片刻。",
      "file": "c021.ogg",
      "durationSec": 5.352
    },
    {
      "index": 22,
      "text": "准备好后，睁开眼睛。",
      "file": "c022.ogg",
      "durationSec": 4.728
    }
  ]
}
