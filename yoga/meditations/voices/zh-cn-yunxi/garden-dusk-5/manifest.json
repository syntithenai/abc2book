{
  "id": "garden-dusk-5",
  "voiceId": "zh-cn-yunxi",
  "edgeVoice": "zh-CN-YunxiNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 319,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.688
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.736
    },
    {
      "index": 2,
      "text": "让你的双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.224
    },
    {
      "index": 3,
      "text": "让你的眼睛闭上，或者软化你的目光。",
      "file": "c003.ogg",
      "durationSec": 6.456
    },
    {
      "index": 4,
      "text": "注意你所承受的身体重量。",
      "file": "c004.ogg",
      "durationSec": 5.256
    },
    {
      "index": 5,
      "text": "通过鼻子缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 4.632
    },
    {
      "index": 6,
      "text": "并且呼气时间更长、更轻松。",
      "file": "c006.ogg",
      "durationSec": 7.104
    },
    {
      "index": 7,
      "text": "再次。轻轻吸气。",
      "file": "c007.ogg",
      "durationSec": 5.4
    },
    {
      "index": 8,
      "text": "轻轻呼气。",
      "file": "c008.ogg",
      "durationSec": 3.408
    },
    {
      "index": 9,
      "text": "如果思绪游离，那也没关系。回到呼吸。",
      "file": "c009.ogg",
      "durationSec": 7.968
    },
    {
      "index": 10,
      "text": "想象一下黄昏时分一个安静的围墙花园。",
      "file": "c010.ogg",
      "durationSec": 6.84
    },
    {
      "index": 11,
      "text": "石板路承载着一天中最后的温暖。",
      "file": "c011.ogg",
      "durationSec": 6.528
    },
    {
      "index": 12,
      "text": "通过脚底感受温和的热量。",
      "file": "c012.ogg",
      "durationSec": 5.424
    },
    {
      "index": 13,
      "text": "薰衣草和晚间玫瑰散发出平静的香气。",
      "file": "c013.ogg",
      "durationSec": 6.864
    },
    {
      "index": 14,
      "text": "凉爽的微风从墙上吹过，让你的脖子凉凉的。",
      "file": "c014.ogg",
      "durationSec": 7.872
    },
    {
      "index": 15,
      "text": "经过一个温暖的午后，空气清新。",
      "file": "c015.ogg",
      "durationSec": 5.76
    },
    {
      "index": 16,
      "text": "你在修剪得如呼吸般柔软的树篱之间缓慢行走。",
      "file": "c016.ogg",
      "durationSec": 7.872
    },
    {
      "index": 17,
      "text": "你的手指拂过仍保留着阳光的树叶。",
      "file": "c017.ogg",
      "durationSec": 6.6
    },
    {
      "index": 18,
      "text": "温暖。光滑的。活。",
      "file": "c018.ogg",
      "durationSec": 7.152
    },
    {
      "index": 19,
      "text": "一张木凳在一棵安静的树下等待着。",
      "file": "c019.ogg",
      "durationSec": 6.24
    },
    {
      "index": 20,
      "text": "你坐下。木头靠在你的背上温暖宜人。",
      "file": "c020.ogg",
      "durationSec": 8.04
    },
    {
      "index": 21,
      "text": "头顶上，天空变成了淡紫色和玫瑰色。",
      "file": "c021.ogg",
      "durationSec": 7.368
    },
    {
      "index": 22,
      "text": "鸟儿定居。花园里一片寂静。",
      "file": "c022.ogg",
      "durationSec": 6.576
    },
    {
      "index": 23,
      "text": "感受温暖从石头和木头上逐渐消失的感觉。",
      "file": "c023.ogg",
      "durationSec": 7.776
    },
    {
      "index": 24,
      "text": "感受夜晚清新的凉爽拂过您的脸庞。",
      "file": "c024.ogg",
      "durationSec": 6.552
    },
    {
      "index": 25,
      "text": "吸入香气和宁静。",
      "file": "c025.ogg",
      "durationSec": 4.272
    },
    {
      "index": 26,
      "text": "呼出你带进来的那一天。",
      "file": "c026.ogg",
      "durationSec": 4.272
    },
    {
      "index": 27,
      "text": "一只飞蛾穿过最后的金光。",
      "file": "c027.ogg",
      "durationSec": 5.52
    },
    {
      "index": 28,
      "text": "这里没有什么紧急的事情。一切都足够了。",
      "file": "c028.ogg",
      "durationSec": 7.104
    },
    {
      "index": 29,
      "text": "充分休息。",
      "file": "c029.ogg",
      "durationSec": 3.168
    },
    {
      "index": 30,
      "text": "让你的腹部在黄昏的空气中变软。",
      "file": "c030.ogg",
      "durationSec": 6.0
    },
    {
      "index": 31,
      "text": "让您的下一次呼吸成为一天中最安静的呼吸。",
      "file": "c031.ogg",
      "durationSec": 7.32
    },
    {
      "index": 32,
      "text": "在完成之前，缓慢地沿着小路走一圈。",
      "file": "c032.ogg",
      "durationSec": 7.104
    },
    {
      "index": 33,
      "text": "温暖的石头在脚下冷却。",
      "file": "c033.ogg",
      "durationSec": 5.328
    },
    {
      "index": 34,
      "text": "树篱释放出当天储存的香水。",
      "file": "c034.ogg",
      "durationSec": 5.496
    },
    {
      "index": 35,
      "text": "现在的微风带有傍晚的气息——清新，几乎是甜甜的。",
      "file": "c035.ogg",
      "durationSec": 9.24
    },
    {
      "index": 36,
      "text": "停在门口，还没开门。",
      "file": "c036.ogg",
      "durationSec": 4.8
    },
    {
      "index": 37,
      "text": "感觉肩膀变得多么平静。",
      "file": "c037.ogg",
      "durationSec": 4.608
    },
    {
      "index": 38,
      "text": "像一盏小灯笼一样将花园的寂静带入室内。",
      "file": "c038.ogg",
      "durationSec": 7.128
    },
    {
      "index": 39,
      "text": "现在独自在呼吸中休息一会儿。",
      "file": "c039.ogg",
      "durationSec": 5.256
    },
    {
      "index": 40,
      "text": "慢慢吸气。",
      "file": "c040.ogg",
      "durationSec": 3.216
    },
    {
      "index": 41,
      "text": "慢慢呼气。",
      "file": "c041.ogg",
      "durationSec": 3.24
    },
    {
      "index": 42,
      "text": "吸气。",
      "file": "c042.ogg",
      "durationSec": 2.832
    },
    {
      "index": 43,
      "text": "呼气。",
      "file": "c043.ogg",
      "durationSec": 2.88
    },
    {
      "index": 44,
      "text": "身体哪里温暖，哪里就感觉温暖。",
      "file": "c044.ogg",
      "durationSec": 6.264
    },
    {
      "index": 45,
      "text": "空气凉爽的地方都会感到凉爽。",
      "file": "c045.ogg",
      "durationSec": 5.664
    },
    {
      "index": 46,
      "text": "吸气。",
      "file": "c046.ogg",
      "durationSec": 2.832
    },
    {
      "index": 47,
      "text": "呼气。",
      "file": "c047.ogg",
      "durationSec": 2.88
    },
    {
      "index": 48,
      "text": "无处可去。没什么可修复的。",
      "file": "c048.ogg",
      "durationSec": 6.672
    },
    {
      "index": 49,
      "text": "吸气。",
      "file": "c049.ogg",
      "durationSec": 2.832
    },
    {
      "index": 50,
      "text": "呼气。",
      "file": "c050.ogg",
      "durationSec": 2.88
    },
    {
      "index": 51,
      "text": "在这里休息一下，安静地呼吸几口气。",
      "file": "c051.ogg",
      "durationSec": 6.72
    },
    {
      "index": 52,
      "text": "要知道你可以随时回到这个地方。",
      "file": "c052.ogg",
      "durationSec": 6.312
    },
    {
      "index": 53,
      "text": "当你准备好后，加深呼吸。",
      "file": "c053.ogg",
      "durationSec": 5.4
    },
    {
      "index": 54,
      "text": "摆动手指和脚趾。",
      "file": "c054.ogg",
      "durationSec": 4.32
    },
    {
      "index": 55,
      "text": "轻轻地睁开眼睛。",
      "file": "c055.ogg",
      "durationSec": 3.936
    },
    {
      "index": 56,
      "text": "随身携带一点这种平静。",
      "file": "c056.ogg",
      "durationSec": 4.488
    }
  ]
}
