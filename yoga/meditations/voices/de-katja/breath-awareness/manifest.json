{
  "id": "breath-awareness",
  "voiceId": "de-katja",
  "edgeVoice": "de-DE-KatjaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 152,
  "chunks": [
    {
      "index": 0,
      "text": "Nehmen Sie eine stabile Haltung ein.",
      "file": "c000.ogg",
      "durationSec": 5.448
    },
    {
      "index": 1,
      "text": "Wirbelsäule hoch, aber nicht steif.",
      "file": "c001.ogg",
      "durationSec": 5.688
    },
    {
      "index": 2,
      "text": "Lenken Sie Ihre Aufmerksamkeit auf den Atem, so wie er bereits ist.",
      "file": "c002.ogg",
      "durationSec": 8.736
    },
    {
      "index": 3,
      "text": "Ändern Sie es noch nicht. Schau einfach zu.",
      "file": "c003.ogg",
      "durationSec": 7.08
    },
    {
      "index": 4,
      "text": "Spüren Sie die Kühle des Einatmens in den Nasenlöchern.",
      "file": "c004.ogg",
      "durationSec": 7.536
    },
    {
      "index": 5,
      "text": "Spüren Sie die Wärme des Ausatmens.",
      "file": "c005.ogg",
      "durationSec": 5.592
    },
    {
      "index": 6,
      "text": "Oder bemerken Sie das Heben und Senken des Bauches.",
      "file": "c006.ogg",
      "durationSec": 6.768
    },
    {
      "index": 7,
      "text": "Wählen Sie einen Ort, an dem Sie Ihre Aufmerksamkeit ruhen lassen können.",
      "file": "c007.ogg",
      "durationSec": 9.096
    },
    {
      "index": 8,
      "text": "Wenn die Gedanken abschweifen, kehren Sie freundlich zurück.",
      "file": "c008.ogg",
      "durationSec": 7.68
    },
    {
      "index": 9,
      "text": "Kein Urteil. Kommen Sie einfach zurück.",
      "file": "c009.ogg",
      "durationSec": 7.08
    },
    {
      "index": 10,
      "text": "Wenn es sich jetzt leicht anfühlt, zählen Sie die sanften Zyklen.",
      "file": "c010.ogg",
      "durationSec": 8.232
    },
    {
      "index": 11,
      "text": "Einatmen. Eins.",
      "file": "c011.ogg",
      "durationSec": 5.232
    },
    {
      "index": 12,
      "text": "Ausatmen. Eins.",
      "file": "c012.ogg",
      "durationSec": 5.208
    },
    {
      "index": 13,
      "text": "Einatmen. Zwei.",
      "file": "c013.ogg",
      "durationSec": 5.16
    },
    {
      "index": 14,
      "text": "Ausatmen. Zwei.",
      "file": "c014.ogg",
      "durationSec": 5.16
    },
    {
      "index": 15,
      "text": "Fahren Sie bis fünf fort und beginnen Sie dann erneut bei eins.",
      "file": "c015.ogg",
      "durationSec": 7.728
    },
    {
      "index": 16,
      "text": "Wenn Sie den Überblick verlieren, beginnen Sie noch einmal mit Freundlichkeit.",
      "file": "c016.ogg",
      "durationSec": 9.288
    },
    {
      "index": 17,
      "text": "Das Zurückkehren ist die Praxis.",
      "file": "c017.ogg",
      "durationSec": 5.016
    },
    {
      "index": 18,
      "text": "Lassen Sie den Atem natürlich sein. Keine Belastung.",
      "file": "c018.ogg",
      "durationSec": 8.376
    },
    {
      "index": 19,
      "text": "Noch ein paar Zyklen in Stille.",
      "file": "c019.ogg",
      "durationSec": 4.728
    },
    {
      "index": 20,
      "text": "Lassen Sie die Zählung los.",
      "file": "c020.ogg",
      "durationSec": 4.272
    },
    {
      "index": 21,
      "text": "Ruhen Sie für einen Moment im offenen Bewusstsein.",
      "file": "c021.ogg",
      "durationSec": 6.648
    },
    {
      "index": 22,
      "text": "Wenn Sie bereit sind, öffnen Sie Ihre Augen.",
      "file": "c022.ogg",
      "durationSec": 6.432
    }
  ]
}
