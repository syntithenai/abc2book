{
  "id": "calm-arrive",
  "voiceId": "es-elvira",
  "edgeVoice": "es-ES-ElviraNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 107,
  "chunks": [
    {
      "index": 0,
      "text": "Bienvenido.",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "Tómate un momento para llegar.",
      "file": "c001.ogg",
      "durationSec": 4.488
    },
    {
      "index": 2,
      "text": "Busque un asiento cómodo o acuéstese si se siente mejor.",
      "file": "c002.ogg",
      "durationSec": 7.104
    },
    {
      "index": 3,
      "text": "Deja que tus manos descansen.",
      "file": "c003.ogg",
      "durationSec": 4.632
    },
    {
      "index": 4,
      "text": "Deja que tus ojos se cierren o suaviza tu mirada.",
      "file": "c004.ogg",
      "durationSec": 6.192
    },
    {
      "index": 5,
      "text": "Fíjate que estás aquí.",
      "file": "c005.ogg",
      "durationSec": 4.008
    },
    {
      "index": 6,
      "text": "No hay nada que arreglar ahora.",
      "file": "c006.ogg",
      "durationSec": 4.632
    },
    {
      "index": 7,
      "text": "Nada que completar.",
      "file": "c007.ogg",
      "durationSec": 3.672
    },
    {
      "index": 8,
      "text": "Respire lentamente por la nariz.",
      "file": "c008.ogg",
      "durationSec": 5.112
    },
    {
      "index": 9,
      "text": "Y una exhalación más larga.",
      "file": "c009.ogg",
      "durationSec": 4.512
    },
    {
      "index": 10,
      "text": "De nuevo. Inhala suavemente.",
      "file": "c010.ogg",
      "durationSec": 6.384
    },
    {
      "index": 11,
      "text": "Exhala suavemente.",
      "file": "c011.ogg",
      "durationSec": 3.96
    },
    {
      "index": 12,
      "text": "Siente el peso de tu cuerpo apoyado.",
      "file": "c012.ogg",
      "durationSec": 5.16
    },
    {
      "index": 13,
      "text": "El suelo, la silla, la tierra que te sostiene.",
      "file": "c013.ogg",
      "durationSec": 6.696
    },
    {
      "index": 14,
      "text": "Si los pensamientos divagan, está bien.",
      "file": "c014.ogg",
      "durationSec": 5.544
    },
    {
      "index": 15,
      "text": "Simplemente observa y regresa a esta respiración.",
      "file": "c015.ogg",
      "durationSec": 6.744
    },
    {
      "index": 16,
      "text": "Inhalar. Llegar.",
      "file": "c016.ogg",
      "durationSec": 5.16
    },
    {
      "index": 17,
      "text": "Exhalar. Asentarse.",
      "file": "c017.ogg",
      "durationSec": 5.784
    },
    {
      "index": 18,
      "text": "Un respiro más tranquilo.",
      "file": "c018.ogg",
      "durationSec": 4.44
    },
    {
      "index": 19,
      "text": "Cuando estés listo, abre los ojos.",
      "file": "c019.ogg",
      "durationSec": 5.376
    },
    {
      "index": 20,
      "text": "Lleva este silencio contigo.",
      "file": "c020.ogg",
      "durationSec": 4.584
    }
  ]
}
