  "totalSec": 158,
  "chunks": [
    {
      "index": 0,
      "text": "Escanearemos suavemente el cuerpo.",
      "file": "c000.ogg",
      "durationSec": 5.136
    },
    {
      "index": 1,
      "text": "Acuéstate o siéntate con facilidad.",
      "file": "c001.ogg",
      "durationSec": 5.112
    },
    {
      "index": 2,
      "text": "Cierra los ojos si te sientes seguro.",
      "file": "c002.ogg",
      "durationSec": 5.184
    },
    {
      "index": 3,
      "text": "Comience en la coronilla de la cabeza.",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "Note cualquier sensación allí. Calor. Frescura. Nada en absoluto.",
      "file": "c004.ogg",
      "durationSec": 13.392
    },
    {
      "index": 5,
      "text": "No es necesario cambiarlo. Sólo fíjate.",
      "file": "c005.ogg",
      "durationSec": 7.728
    },
    {
      "index": 6,
      "text": "Muévete suavemente hacia la frente y los ojos.",
      "file": "c006.ogg",
      "durationSec": 6.192
    },
    {
      "index": 7,
      "text": "Let the tiny muscles around the eyes soften.",
      "file": "c007.ogg",
      "durationSec": 5.904
    },
    {
      "index": 8,
      "text": "Siente la mandíbula. Afloja si puedes.",
      "file": "c008.ogg",
      "durationSec": 7.488
    },
    {
      "index": 9,
      "text": "Lengua descansando ligeramente.",
      "file": "c009.ogg",
      "durationSec": 4.968
    },
    {
      "index": 10,
      "text": "Espalda. ¿Están levantados? Déjalos caer un poco.",
      "file": "c010.ogg",
      "durationSec": 10.296
    },
    {
      "index": 11,
      "text": "Brazos pesados. Manos abiertas o suaves.",
      "file": "c011.ogg",
      "durationSec": 8.136
    },
    {
      "index": 12,
      "text": "El pecho sube y baja con la respiración.",
      "file": "c012.ogg",
      "durationSec": 5.544
    },
    {
      "index": 13,
      "text": "Vientre suave. Sin forzar.",
      "file": "c013.ogg",
      "durationSec": 6.192
    },
    {
      "index": 14,
      "text": "Hips and pelvis resting.",
      "file": "c014.ogg",
      "durationSec": 4.344
    },
    {
      "index": 15,
      "text": "Muslos. Rodillas. Piernas inferiores.",
      "file": "c015.ogg",
      "durationSec": 9.624
    },
    {
      "index": 16,
      "text": "Pies. Suelas tocando el suelo o la colchoneta.",
      "file": "c016.ogg",
      "durationSec": 7.92
    },
    {
      "index": 17,
      "text": "Ahora sienta todo el cuerpo como un campo de conciencia.",
      "file": "c017.ogg",
      "durationSec": 6.648
    },
    {
      "index": 18,
      "text": "Respiración moviéndose a través de él.",
      "file": "c018.ogg",
      "durationSec": 5.424
    },
    {
      "index": 19,
      "text": "Si aparece un punto tenso, envía una amable exhalación allí.",
      "file": "c019.ogg",
      "durationSec": 7.944
    },
    {
      "index": 20,
      "text": "Quédese tres respiraciones tranquilas.",
      "file": "c020.ogg",
      "durationSec": 5.568
    },
    {
      "index": 21,
      "text": "Cuando esté listo, mueva los dedos de las manos y los pies.",
      "file": "c021.ogg",
      "durationSec": 6.984
    },
    {
      "index": 22,
      "text": "Abre los ojos. Regrese suavemente.",
      "file": "c022.ogg",
      "durationSec": 7.344
    }
  ]
}
