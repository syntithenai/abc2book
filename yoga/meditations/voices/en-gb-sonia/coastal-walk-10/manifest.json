{
  "id": "coastal-walk-10",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 513,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.896
    },
    {
      "index": 1,
      "text": "Find a posture that asks nothing of you.",
      "file": "c001.ogg",
      "durationSec": 5.112
    },
    {
      "index": 2,
      "text": "Sit, or lie down, with whatever support you need.",
      "file": "c002.ogg",
      "durationSec": 6.504
    },
    {
      "index": 3,
      "text": "Let your hands rest open or soft.",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 6.0
    },
    {
      "index": 5,
      "text": "Feel the places where your body meets the ground.",
      "file": "c005.ogg",
      "durationSec": 5.592
    },
    {
      "index": 6,
      "text": "The heels, the sit bones, the back of the head, or the length of the spine.",
      "file": "c006.ogg",
      "durationSec": 8.472
    },
    {
      "index": 7,
      "text": "Nothing to hold up right now.",
      "file": "c007.ogg",
      "durationSec": 3.744
    },
    {
      "index": 8,
      "text": "Take a slow breath in through the nose.",
      "file": "c008.ogg",
      "durationSec": 4.44
    },
    {
      "index": 9,
      "text": "Feel the coolness of the air arriving.",
      "file": "c009.ogg",
      "durationSec": 4.584
    },
    {
      "index": 10,
      "text": "And breathe out a little longer.",
      "file": "c010.ogg",
      "durationSec": 3.72
    },
    {
      "index": 11,
      "text": "Feel the warmth of the exhale leaving.",
      "file": "c011.ogg",
      "durationSec": 4.68
    },
    {
      "index": 12,
      "text": "Again. Soft inhale.",
      "file": "c012.ogg",
      "durationSec": 4.272
    },
    {
      "index": 13,
      "text": "Unhurried exhale.",
      "file": "c013.ogg",
      "durationSec": 3.048
    },
    {
      "index": 14,
      "text": "Let the shoulders drop a fraction.",
      "file": "c014.ogg",
      "durationSec": 4.224
    },
    {
      "index": 15,
      "text": "Let the jaw unclench.",
      "file": "c015.ogg",
      "durationSec": 3.456
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 3.384
    },
    {
      "index": 17,
      "text": "Stay with three quiet breaths, just as they are.",
      "file": "c017.ogg",
      "durationSec": 5.928
    },
    {
      "index": 18,
      "text": "Inhale. Arrive.",
      "file": "c018.ogg",
      "durationSec": 3.768
    },
    {
      "index": 19,
      "text": "Exhale. Settle.",
      "file": "c019.ogg",
      "durationSec": 3.792
    },
    {
      "index": 20,
      "text": "If the mind wanders, notice it kindly, and come back to this breath.",
      "file": "c020.ogg",
      "durationSec": 7.968
    },
    {
      "index": 21,
      "text": "See a coastal path along low cliffs.",
      "file": "c021.ogg",
      "durationSec": 5.184
    },
    {
      "index": 22,
      "text": "The ocean breathes below in long, steady rolls.",
      "file": "c022.ogg",
      "durationSec": 6.312
    },
    {
      "index": 23,
      "text": "Sunlight warms the crown of your head and the bridge of your nose.",
      "file": "c023.ogg",
      "durationSec": 6.864
    },
    {
      "index": 24,
      "text": "A salt breeze cools your eyelids with bright freshness.",
      "file": "c024.ogg",
      "durationSec": 6.24
    },
    {
      "index": 25,
      "text": "Smell the sea — mineral, clean, awake.",
      "file": "c025.ogg",
      "durationSec": 6.024
    },
    {
      "index": 26,
      "text": "You walk slowly. Grasses lean inland in the wind.",
      "file": "c026.ogg",
      "durationSec": 7.152
    },
    {
      "index": 27,
      "text": "Feel sun on one cheek, cool air on the other.",
      "file": "c027.ogg",
      "durationSec": 5.928
    },
    {
      "index": 28,
      "text": "That contrast is itself a kind of calm.",
      "file": "c028.ogg",
      "durationSec": 5.088
    },
    {
      "index": 29,
      "text": "A wooden stair leads down toward a hidden beach.",
      "file": "c029.ogg",
      "durationSec": 5.592
    },
    {
      "index": 30,
      "text": "Each step is sure. Your hand rests on a weathered rail.",
      "file": "c030.ogg",
      "durationSec": 7.248
    },
    {
      "index": 31,
      "text": "Warm wood under your palm.",
      "file": "c031.ogg",
      "durationSec": 3.432
    },
    {
      "index": 32,
      "text": "At the bottom, sand receives your feet like a soft yes.",
      "file": "c032.ogg",
      "durationSec": 6.768
    },
    {
      "index": 33,
      "text": "Walk to where waves write and erase white lines.",
      "file": "c033.ogg",
      "durationSec": 5.952
    },
    {
      "index": 34,
      "text": "Cool water folds over your ankles.",
      "file": "c034.ogg",
      "durationSec": 4.656
    },
    {
      "index": 35,
      "text": "Warm sand higher on the shore waits when you step back.",
      "file": "c035.ogg",
      "durationSec": 6.264
    },
    {
      "index": 36,
      "text": "Sit. Dig your hands into sun-heated grains.",
      "file": "c036.ogg",
      "durationSec": 6.84
    },
    {
      "index": 37,
      "text": "Feel that dry warmth against cool damp sand beneath.",
      "file": "c037.ogg",
      "durationSec": 6.36
    },
    {
      "index": 38,
      "text": "Watch light shatter across open water.",
      "file": "c038.ogg",
      "durationSec": 5.088
    },
    {
      "index": 39,
      "text": "Breathe in the freshness of the breeze.",
      "file": "c039.ogg",
      "durationSec": 4.44
    },
    {
      "index": 40,
      "text": "Breathe out any tightness still held in the ribs.",
      "file": "c040.ogg",
      "durationSec": 5.592
    },
    {
      "index": 41,
      "text": "A gull cries once and becomes part of the hush.",
      "file": "c041.ogg",
      "durationSec": 5.808
    },
    {
      "index": 42,
      "text": "Lie back. Close your eyes.",
      "file": "c042.ogg",
      "durationSec": 4.656
    },
    {
      "index": 43,
      "text": "Warmth across your front. Cool earth-shadow at your sides.",
      "file": "c043.ogg",
      "durationSec": 7.8
    },
    {
      "index": 44,
      "text": "The tide’s rhythm coaches your heart toward ease.",
      "file": "c044.ogg",
      "durationSec": 5.664
    },
    {
      "index": 45,
      "text": "You are small in the best way — held by something vast and kind.",
      "file": "c045.ogg",
      "durationSec": 7.152
    },
    {
      "index": 46,
      "text": "Stay with the warmth of the sun on your closed eyes.",
      "file": "c046.ogg",
      "durationSec": 5.904
    },
    {
      "index": 47,
      "text": "Stay with the cool kiss of spray on your skin when the wind turns.",
      "file": "c047.ogg",
      "durationSec": 6.96
    },
    {
      "index": 48,
      "text": "Peace is not elsewhere. It is this shore, this breath, this body.",
      "file": "c048.ogg",
      "durationSec": 8.568
    },
    {
      "index": 49,
      "text": "Dig your heels a little deeper into warm sand.",
      "file": "c049.ogg",
      "durationSec": 5.88
    },
    {
      "index": 50,
      "text": "Feel how the earth answers with steady support.",
      "file": "c050.ogg",
      "durationSec": 5.64
    },
    {
      "index": 51,
      "text": "Breathe in salt freshness to the bottom of the lungs.",
      "file": "c051.ogg",
      "durationSec": 5.976
    },
    {
      "index": 52,
      "text": "Breathe out anything that has been bracing for impact.",
      "file": "c052.ogg",
      "durationSec": 6.12
    },
    {
      "index": 53,
      "text": "There is no impact here. Only arrival after arrival of waves.",
      "file": "c053.ogg",
      "durationSec": 8.328
    },
    {
      "index": 54,
      "text": "Let five breaths ride that same patient rhythm.",
      "file": "c054.ogg",
      "durationSec": 5.808
    },
    {
      "index": 55,
      "text": "Then rest in the afterglow of sun on skin.",
      "file": "c055.ogg",
      "durationSec": 5.568
    },
    {
      "index": 56,
      "text": "Rise and walk the waterline a short way.",
      "file": "c056.ogg",
      "durationSec": 5.208
    },
    {
      "index": 57,
      "text": "Left foot cool and wet. Right foot warm and dry. Then switch.",
      "file": "c057.ogg",
      "durationSec": 9.624
    },
    {
      "index": 58,
      "text": "The body learns contrast as comfort, not conflict.",
      "file": "c058.ogg",
      "durationSec": 6.816
    },
    {
      "index": 59,
      "text": "Pick up a smooth stone warmed by light.",
      "file": "c059.ogg",
      "durationSec": 5.064
    },
    {
      "index": 60,
      "text": "Feel its heat in the palm. Its density. Its quiet.",
      "file": "c060.ogg",
      "durationSec": 8.184
    },
    {
      "index": 61,
      "text": "Set it down with thanks — no need to keep it.",
      "file": "c061.ogg",
      "durationSec": 5.376
    },
    {
      "index": 62,
      "text": "The keeping is inward.",
      "file": "c062.ogg",
      "durationSec": 3.12
    },
    {
      "index": 63,
      "text": "Look out past the breakers to calmer color.",
      "file": "c063.ogg",
      "durationSec": 5.16
    },
    {
      "index": 64,
      "text": "Breathe as if you could taste blue.",
      "file": "c064.ogg",
      "durationSec": 4.008
    },
    {
      "index": 65,
      "text": "Fresh breeze. Warm cheek. Soft belly.",
      "file": "c065.ogg",
      "durationSec": 7.104
    },
    {
      "index": 66,
      "text": "Let the next inhale be the deepest of the practice.",
      "file": "c066.ogg",
      "durationSec": 6.024
    },
    {
      "index": 67,
      "text": "Let the exhale empty without force.",
      "file": "c067.ogg",
      "durationSec": 4.992
    },
    {
      "index": 68,
      "text": "The cove, the cliff, the path home — all wait without pressure.",
      "file": "c068.ogg",
      "durationSec": 7.656
    },
    {
      "index": 69,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c069.ogg",
      "durationSec": 6.336
    },
    {
      "index": 70,
      "text": "Inhale the freshness of this place.",
      "file": "c070.ogg",
      "durationSec": 4.536
    },
    {
      "index": 71,
      "text": "Exhale into its warmth and quiet.",
      "file": "c071.ogg",
      "durationSec": 4.944
    },
    {
      "index": 72,
      "text": "Inhale.",
      "file": "c072.ogg",
      "durationSec": 1.992
    },
    {
      "index": 73,
      "text": "Exhale.",
      "file": "c073.ogg",
      "durationSec": 1.992
    },
    {
      "index": 74,
      "text": "Again. Soft inhale.",
      "file": "c074.ogg",
      "durationSec": 4.272
    },
    {
      "index": 75,
      "text": "Longer exhale.",
      "file": "c075.ogg",
      "durationSec": 2.904
    },
    {
      "index": 76,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c076.ogg",
      "durationSec": 6.672
    },
    {
      "index": 77,
      "text": "Inhale.",
      "file": "c077.ogg",
      "durationSec": 1.992
    },
    {
      "index": 78,
      "text": "Exhale.",
      "file": "c078.ogg",
      "durationSec": 1.992
    },
    {
      "index": 79,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c079.ogg",
      "durationSec": 5.88
    },
    {
      "index": 80,
      "text": "Or to cool air at the nose.",
      "file": "c080.ogg",
      "durationSec": 3.768
    },
    {
      "index": 81,
      "text": "Inhale.",
      "file": "c081.ogg",
      "durationSec": 1.992
    },
    {
      "index": 82,
      "text": "Exhale.",
      "file": "c082.ogg",
      "durationSec": 1.992
    },
    {
      "index": 83,
      "text": "Inhale.",
      "file": "c083.ogg",
      "durationSec": 1.992
    },
    {
      "index": 84,
      "text": "Exhale.",
      "file": "c084.ogg",
      "durationSec": 1.992
    },
    {
      "index": 85,
      "text": "Stay. Soften. Continue.",
      "file": "c085.ogg",
      "durationSec": 5.64
    },
    {
      "index": 86,
      "text": "Inhale.",
      "file": "c086.ogg",
      "durationSec": 1.992
    },
    {
      "index": 87,
      "text": "Exhale.",
      "file": "c087.ogg",
      "durationSec": 1.992
    },
    {
      "index": 88,
      "text": "One more easy cycle.",
      "file": "c088.ogg",
      "durationSec": 3.432
    },
    {
      "index": 89,
      "text": "Inhale.",
      "file": "c089.ogg",
      "durationSec": 1.992
    },
    {
      "index": 90,
      "text": "Exhale.",
      "file": "c090.ogg",
      "durationSec": 1.992
    },
    {
      "index": 91,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c091.ogg",
      "durationSec": 5.208
    },
    {
      "index": 92,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c092.ogg",
      "durationSec": 6.168
    },
    {
      "index": 93,
      "text": "You can return to this place whenever you need it.",
      "file": "c093.ogg",
      "durationSec": 5.496
    },
    {
      "index": 94,
      "text": "It lives in your attention, not only in imagination.",
      "file": "c094.ogg",
      "durationSec": 6.384
    },
    {
      "index": 95,
      "text": "Begin to deepen the breath.",
      "file": "c095.ogg",
      "durationSec": 3.456
    },
    {
      "index": 96,
      "text": "Feel the room around you again.",
      "file": "c096.ogg",
      "durationSec": 4.08
    },
    {
      "index": 97,
      "text": "Wiggle the fingers. Soften the toes.",
      "file": "c097.ogg",
      "durationSec": 5.664
    },
    {
      "index": 98,
      "text": "When you are ready, open your eyes.",
      "file": "c098.ogg",
      "durationSec": 4.44
    },
    {
      "index": 99,
      "text": "Take one more easy breath.",
      "file": "c099.ogg",
      "durationSec": 3.696
    },
    {
      "index": 100,
      "text": "Carry this calm into whatever comes next.",
      "file": "c100.ogg",
      "durationSec": 5.592
    }
  ]
}
