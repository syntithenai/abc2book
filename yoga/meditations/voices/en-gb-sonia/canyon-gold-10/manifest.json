{
  "id": "canyon-gold-10",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 523,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.896
    },
    {
      "index": 1,
      "text": "Find a posture that asks nothing of you.",
      "file": "c001.ogg",
      "durationSec": 5.112
    },
    {
      "index": 2,
      "text": "Sit, or lie down, with whatever support you need.",
      "file": "c002.ogg",
      "durationSec": 6.504
    },
    {
      "index": 3,
      "text": "Let your hands rest open or soft.",
      "file": "c003.ogg",
      "durationSec": 5.016
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 6.0
    },
    {
      "index": 5,
      "text": "Feel the places where your body meets the ground.",
      "file": "c005.ogg",
      "durationSec": 5.592
    },
    {
      "index": 6,
      "text": "The heels, the sit bones, the back of the head, or the length of the spine.",
      "file": "c006.ogg",
      "durationSec": 8.472
    },
    {
      "index": 7,
      "text": "Nothing to hold up right now.",
      "file": "c007.ogg",
      "durationSec": 3.744
    },
    {
      "index": 8,
      "text": "Take a slow breath in through the nose.",
      "file": "c008.ogg",
      "durationSec": 4.44
    },
    {
      "index": 9,
      "text": "Feel the coolness of the air arriving.",
      "file": "c009.ogg",
      "durationSec": 4.584
    },
    {
      "index": 10,
      "text": "And breathe out a little longer.",
      "file": "c010.ogg",
      "durationSec": 3.72
    },
    {
      "index": 11,
      "text": "Feel the warmth of the exhale leaving.",
      "file": "c011.ogg",
      "durationSec": 4.68
    },
    {
      "index": 12,
      "text": "Again. Soft inhale.",
      "file": "c012.ogg",
      "durationSec": 4.272
    },
    {
      "index": 13,
      "text": "Unhurried exhale.",
      "file": "c013.ogg",
      "durationSec": 3.048
    },
    {
      "index": 14,
      "text": "Let the shoulders drop a fraction.",
      "file": "c014.ogg",
      "durationSec": 4.224
    },
    {
      "index": 15,
      "text": "Let the jaw unclench.",
      "file": "c015.ogg",
      "durationSec": 3.456
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 3.384
    },
    {
      "index": 17,
      "text": "Stay with three quiet breaths, just as they are.",
      "file": "c017.ogg",
      "durationSec": 5.928
    },
    {
      "index": 18,
      "text": "Inhale. Arrive.",
      "file": "c018.ogg",
      "durationSec": 3.768
    },
    {
      "index": 19,
      "text": "Exhale. Settle.",
      "file": "c019.ogg",
      "durationSec": 3.792
    },
    {
      "index": 20,
      "text": "If the mind wanders, notice it kindly, and come back to this breath.",
      "file": "c020.ogg",
      "durationSec": 7.968
    },
    {
      "index": 21,
      "text": "Imagine a wide canyon painted in soft gold and rose.",
      "file": "c021.ogg",
      "durationSec": 6.888
    },
    {
      "index": 22,
      "text": "It is late afternoon. The light is generous.",
      "file": "c022.ogg",
      "durationSec": 6.288
    },
    {
      "index": 23,
      "text": "Warmth radiates from stone that has held the sun all day.",
      "file": "c023.ogg",
      "durationSec": 6.792
    },
    {
      "index": 24,
      "text": "Feel that radiant heat on your shins and the backs of your hands.",
      "file": "c024.ogg",
      "durationSec": 7.032
    },
    {
      "index": 25,
      "text": "A dry, fresh breeze moves down the canyon floor.",
      "file": "c025.ogg",
      "durationSec": 6.168
    },
    {
      "index": 26,
      "text": "It cools your face without taking the comfort of the warmth.",
      "file": "c026.ogg",
      "durationSec": 6.432
    },
    {
      "index": 27,
      "text": "You walk a sandy path between quiet walls.",
      "file": "c027.ogg",
      "durationSec": 5.592
    },
    {
      "index": 28,
      "text": "Footsteps whisper. Echoes are soft, almost polite.",
      "file": "c028.ogg",
      "durationSec": 7.776
    },
    {
      "index": 29,
      "text": "Smell sunbaked earth, sage, and clean dust.",
      "file": "c029.ogg",
      "durationSec": 6.648
    },
    {
      "index": 30,
      "text": "Place your palm on smooth stone.",
      "file": "c030.ogg",
      "durationSec": 4.32
    },
    {
      "index": 31,
      "text": "Feel stored daylight there — steady, patient heat.",
      "file": "c031.ogg",
      "durationSec": 6.48
    },
    {
      "index": 32,
      "text": "A ribbon of shade offers coolness for a few steps.",
      "file": "c032.ogg",
      "durationSec": 5.976
    },
    {
      "index": 33,
      "text": "Then sun again, warm across your shoulders like a shawl.",
      "file": "c033.ogg",
      "durationSec": 6.456
    },
    {
      "index": 34,
      "text": "You come to a place where the canyon opens.",
      "file": "c034.ogg",
      "durationSec": 4.944
    },
    {
      "index": 35,
      "text": "Sit on a flat rock still holding golden warmth.",
      "file": "c035.ogg",
      "durationSec": 5.952
    },
    {
      "index": 36,
      "text": "Feel it rise through your seat and spine.",
      "file": "c036.ogg",
      "durationSec": 4.752
    },
    {
      "index": 37,
      "text": "Feel the fresher air of altitude in every inhale.",
      "file": "c037.ogg",
      "durationSec": 6.36
    },
    {
      "index": 38,
      "text": "Far above, a hawk turns slow circles without hurry.",
      "file": "c038.ogg",
      "durationSec": 6.744
    },
    {
      "index": 39,
      "text": "You borrow that unhurried quality.",
      "file": "c039.ogg",
      "durationSec": 4.56
    },
    {
      "index": 40,
      "text": "Breath long. Body heavy. Mind wide as the sky between walls.",
      "file": "c040.ogg",
      "durationSec": 9.432
    },
    {
      "index": 41,
      "text": "Watch shadow climb the far cliff as the sun lowers.",
      "file": "c041.ogg",
      "durationSec": 6.024
    },
    {
      "index": 42,
      "text": "Colors deepen. Warmth softens but does not vanish.",
      "file": "c042.ogg",
      "durationSec": 7.248
    },
    {
      "index": 43,
      "text": "The breeze smells cooler now, evening-fresh.",
      "file": "c043.ogg",
      "durationSec": 5.496
    },
    {
      "index": 44,
      "text": "Wrap your arms around yourself for a moment.",
      "file": "c044.ogg",
      "durationSec": 5.136
    },
    {
      "index": 45,
      "text": "Warmth of your own body. Warmth of stone. Enough.",
      "file": "c045.ogg",
      "durationSec": 7.752
    },
    {
      "index": 46,
      "text": "Lie back carefully and watch the first quiet star.",
      "file": "c046.ogg",
      "durationSec": 6.072
    },
    {
      "index": 47,
      "text": "The canyon holds you the way a cupped hand holds water — gently, without spill.",
      "file": "c047.ogg",
      "durationSec": 8.712
    },
    {
      "index": 48,
      "text": "Rest in that held feeling.",
      "file": "c048.ogg",
      "durationSec": 3.624
    },
    {
      "index": 49,
      "text": "Notice the last heat rising from rock into the cooling air.",
      "file": "c049.ogg",
      "durationSec": 6.864
    },
    {
      "index": 50,
      "text": "Notice how the breeze now smells of evening and dust and sage.",
      "file": "c050.ogg",
      "durationSec": 7.296
    },
    {
      "index": 51,
      "text": "Your breath has slowed to match the wide quiet.",
      "file": "c051.ogg",
      "durationSec": 5.376
    },
    {
      "index": 52,
      "text": "If tension remains in the brow, soften it in this gold light.",
      "file": "c052.ogg",
      "durationSec": 7.488
    },
    {
      "index": 53,
      "text": "If the jaw is tight, let it hang loose as the hawk’s easy turn.",
      "file": "c053.ogg",
      "durationSec": 7.344
    },
    {
      "index": 54,
      "text": "Stay for a few more cycles of warm stone and fresh air.",
      "file": "c054.ogg",
      "durationSec": 6.648
    },
    {
      "index": 55,
      "text": "You are not late. You are here.",
      "file": "c055.ogg",
      "durationSec": 4.704
    },
    {
      "index": 56,
      "text": "Walk a few more steps along warm sand between canyon walls.",
      "file": "c056.ogg",
      "durationSec": 7.344
    },
    {
      "index": 57,
      "text": "Your shadow stretches long and unworried.",
      "file": "c057.ogg",
      "durationSec": 5.304
    },
    {
      "index": 58,
      "text": "Place both palms on stone again.",
      "file": "c058.ogg",
      "durationSec": 4.44
    },
    {
      "index": 59,
      "text": "Heat enters the hands like a blessing you do not have to earn.",
      "file": "c059.ogg",
      "durationSec": 6.48
    },
    {
      "index": 60,
      "text": "The breeze combs coolness through your hair.",
      "file": "c060.ogg",
      "durationSec": 4.704
    },
    {
      "index": 61,
      "text": "Sage scent. Dust scent. Sun scent.",
      "file": "c061.ogg",
      "durationSec": 6.96
    },
    {
      "index": 62,
      "text": "Sit. Knees soft. Spine easy.",
      "file": "c062.ogg",
      "durationSec": 6.264
    },
    {
      "index": 63,
      "text": "Watch color deepen from gold toward rose.",
      "file": "c063.ogg",
      "durationSec": 5.52
    },
    {
      "index": 64,
      "text": "Warmth softens. Freshness increases. Balance remains.",
      "file": "c064.ogg",
      "durationSec": 8.904
    },
    {
      "index": 65,
      "text": "This is how evenings teach the nervous system to downshift.",
      "file": "c065.ogg",
      "durationSec": 6.648
    },
    {
      "index": 66,
      "text": "Borrow the lesson without effort.",
      "file": "c066.ogg",
      "durationSec": 4.344
    },
    {
      "index": 67,
      "text": "Three breaths for the stone.",
      "file": "c067.ogg",
      "durationSec": 3.624
    },
    {
      "index": 68,
      "text": "Three for the sky.",
      "file": "c068.ogg",
      "durationSec": 2.856
    },
    {
      "index": 69,
      "text": "Three for the quiet animal of your own body, resting.",
      "file": "c069.ogg",
      "durationSec": 6.576
    },
    {
      "index": 70,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c070.ogg",
      "durationSec": 6.336
    },
    {
      "index": 71,
      "text": "Inhale the freshness of this place.",
      "file": "c071.ogg",
      "durationSec": 4.536
    },
    {
      "index": 72,
      "text": "Exhale into its warmth and quiet.",
      "file": "c072.ogg",
      "durationSec": 4.944
    },
    {
      "index": 73,
      "text": "Inhale.",
      "file": "c073.ogg",
      "durationSec": 1.992
    },
    {
      "index": 74,
      "text": "Exhale.",
      "file": "c074.ogg",
      "durationSec": 1.992
    },
    {
      "index": 75,
      "text": "Again. Soft inhale.",
      "file": "c075.ogg",
      "durationSec": 4.272
    },
    {
      "index": 76,
      "text": "Longer exhale.",
      "file": "c076.ogg",
      "durationSec": 2.904
    },
    {
      "index": 77,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c077.ogg",
      "durationSec": 6.672
    },
    {
      "index": 78,
      "text": "Inhale.",
      "file": "c078.ogg",
      "durationSec": 1.992
    },
    {
      "index": 79,
      "text": "Exhale.",
      "file": "c079.ogg",
      "durationSec": 1.992
    },
    {
      "index": 80,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c080.ogg",
      "durationSec": 5.88
    },
    {
      "index": 81,
      "text": "Or to cool air at the nose.",
      "file": "c081.ogg",
      "durationSec": 3.768
    },
    {
      "index": 82,
      "text": "Inhale.",
      "file": "c082.ogg",
      "durationSec": 1.992
    },
    {
      "index": 83,
      "text": "Exhale.",
      "file": "c083.ogg",
      "durationSec": 1.992
    },
    {
      "index": 84,
      "text": "Inhale.",
      "file": "c084.ogg",
      "durationSec": 1.992
    },
    {
      "index": 85,
      "text": "Exhale.",
      "file": "c085.ogg",
      "durationSec": 1.992
    },
    {
      "index": 86,
      "text": "Stay. Soften. Continue.",
      "file": "c086.ogg",
      "durationSec": 5.64
    },
    {
      "index": 87,
      "text": "Inhale.",
      "file": "c087.ogg",
      "durationSec": 1.992
    },
    {
      "index": 88,
      "text": "Exhale.",
      "file": "c088.ogg",
      "durationSec": 1.992
    },
    {
      "index": 89,
      "text": "One more easy cycle.",
      "file": "c089.ogg",
      "durationSec": 3.432
    },
    {
      "index": 90,
      "text": "Inhale.",
      "file": "c090.ogg",
      "durationSec": 1.992
    },
    {
      "index": 91,
      "text": "Exhale.",
      "file": "c091.ogg",
      "durationSec": 1.992
    },
    {
      "index": 92,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c092.ogg",
      "durationSec": 5.208
    },
    {
      "index": 93,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c093.ogg",
      "durationSec": 6.168
    },
    {
      "index": 94,
      "text": "You can return to this place whenever you need it.",
      "file": "c094.ogg",
      "durationSec": 5.496
    },
    {
      "index": 95,
      "text": "It lives in your attention, not only in imagination.",
      "file": "c095.ogg",
      "durationSec": 6.384
    },
    {
      "index": 96,
      "text": "Begin to deepen the breath.",
      "file": "c096.ogg",
      "durationSec": 3.456
    },
    {
      "index": 97,
      "text": "Feel the room around you again.",
      "file": "c097.ogg",
      "durationSec": 4.08
    },
    {
      "index": 98,
      "text": "Wiggle the fingers. Soften the toes.",
      "file": "c098.ogg",
      "durationSec": 5.664
    },
    {
      "index": 99,
      "text": "When you are ready, open your eyes.",
      "file": "c099.ogg",
      "durationSec": 4.44
    },
    {
      "index": 100,
      "text": "Take one more easy breath.",
      "file": "c100.ogg",
      "durationSec": 3.696
    },
    {
      "index": 101,
      "text": "Carry this calm into whatever comes next.",
      "file": "c101.ogg",
      "durationSec": 5.592
    }
  ]
}
