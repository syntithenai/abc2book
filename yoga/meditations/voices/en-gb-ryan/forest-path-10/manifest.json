{
  "id": "forest-path-10",
  "voiceId": "en-gb-ryan",
  "edgeVoice": "en-GB-RyanNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 477,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.436
    },
    {
      "index": 1,
      "text": "Find a posture that asks nothing of you.",
      "file": "c001.ogg",
      "durationSec": 4.165
    },
    {
      "index": 2,
      "text": "Sit, or lie down, with whatever support you need.",
      "file": "c002.ogg",
      "durationSec": 5.674
    },
    {
      "index": 3,
      "text": "Let your hands rest open or soft.",
      "file": "c003.ogg",
      "durationSec": 4.217
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 5.613
    },
    {
      "index": 5,
      "text": "Feel the places where your body meets the ground.",
      "file": "c005.ogg",
      "durationSec": 4.914
    },
    {
      "index": 6,
      "text": "The heels, the sit bones, the back of the head, or the length of the spine.",
      "file": "c006.ogg",
      "durationSec": 8.287
    },
    {
      "index": 7,
      "text": "Nothing to hold up right now.",
      "file": "c007.ogg",
      "durationSec": 3.012
    },
    {
      "index": 8,
      "text": "Take a slow breath in through the nose.",
      "file": "c008.ogg",
      "durationSec": 4.165
    },
    {
      "index": 9,
      "text": "Feel the coolness of the air arriving.",
      "file": "c009.ogg",
      "durationSec": 4.341
    },
    {
      "index": 10,
      "text": "And breathe out a little longer.",
      "file": "c010.ogg",
      "durationSec": 3.36
    },
    {
      "index": 11,
      "text": "Feel the warmth of the exhale leaving.",
      "file": "c011.ogg",
      "durationSec": 4.222
    },
    {
      "index": 12,
      "text": "Again. Soft inhale.",
      "file": "c012.ogg",
      "durationSec": 2.887
    },
    {
      "index": 13,
      "text": "Unhurried exhale.",
      "file": "c013.ogg",
      "durationSec": 2.36
    },
    {
      "index": 14,
      "text": "Let the shoulders drop a fraction.",
      "file": "c014.ogg",
      "durationSec": 3.476
    },
    {
      "index": 15,
      "text": "Let the jaw unclench.",
      "file": "c015.ogg",
      "durationSec": 2.768
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 2.592
    },
    {
      "index": 17,
      "text": "Stay with three quiet breaths, just as they are.",
      "file": "c017.ogg",
      "durationSec": 5.439
    },
    {
      "index": 18,
      "text": "Inhale. Arrive.",
      "file": "c018.ogg",
      "durationSec": 2.659
    },
    {
      "index": 19,
      "text": "Exhale. Settle.",
      "file": "c019.ogg",
      "durationSec": 2.716
    },
    {
      "index": 20,
      "text": "If the mind wanders, notice it kindly, and come back to this breath.",
      "file": "c020.ogg",
      "durationSec": 7.183
    },
    {
      "index": 21,
      "text": "Now begin a slow walk into an old forest.",
      "file": "c021.ogg",
      "durationSec": 4.804
    },
    {
      "index": 22,
      "text": "The path is soft with needles and fallen leaves.",
      "file": "c022.ogg",
      "durationSec": 5.214
    },
    {
      "index": 23,
      "text": "Each step makes a quiet sound, then silence returns.",
      "file": "c023.ogg",
      "durationSec": 6.611
    },
    {
      "index": 24,
      "text": "Sunlight threads through high branches in warm ribbons.",
      "file": "c024.ogg",
      "durationSec": 5.959
    },
    {
      "index": 25,
      "text": "Feel a patch of sun on your forearm — sudden gentle heat.",
      "file": "c025.ogg",
      "durationSec": 6.429
    },
    {
      "index": 26,
      "text": "Then shade again, cool and green.",
      "file": "c026.ogg",
      "durationSec": 3.934
    },
    {
      "index": 27,
      "text": "A breeze moves the canopy. Fresh air finds your face.",
      "file": "c027.ogg",
      "durationSec": 6.369
    },
    {
      "index": 28,
      "text": "Smell resin, damp soil, and the clean sweetness of moss.",
      "file": "c028.ogg",
      "durationSec": 6.728
    },
    {
      "index": 29,
      "text": "Pause. Place a palm on rough bark.",
      "file": "c029.ogg",
      "durationSec": 4.278
    },
    {
      "index": 30,
      "text": "Feel the tree’s stillness enter your hand.",
      "file": "c030.ogg",
      "durationSec": 4.75
    },
    {
      "index": 31,
      "text": "Continue deeper. The sounds of the outer world fall away.",
      "file": "c031.ogg",
      "durationSec": 6.612
    },
    {
      "index": 32,
      "text": "Somewhere a stream speaks in small bright syllables.",
      "file": "c032.ogg",
      "durationSec": 5.677
    },
    {
      "index": 33,
      "text": "You follow until water appears between stones.",
      "file": "c033.ogg",
      "durationSec": 5.261
    },
    {
      "index": 34,
      "text": "Kneel. Dip your hands. Cool clarity.",
      "file": "c034.ogg",
      "durationSec": 4.748
    },
    {
      "index": 35,
      "text": "Splash a little on your wrists. Freshness wakes the skin.",
      "file": "c035.ogg",
      "durationSec": 6.379
    },
    {
      "index": 36,
      "text": "Sit on a flat rock warmed by a narrow column of sun.",
      "file": "c036.ogg",
      "durationSec": 6.083
    },
    {
      "index": 37,
      "text": "Feel that warmth in your sit bones and the backs of your thighs.",
      "file": "c037.ogg",
      "durationSec": 6.601
    },
    {
      "index": 38,
      "text": "Feel the cool breath of the stream against your shins.",
      "file": "c038.ogg",
      "durationSec": 5.558
    },
    {
      "index": 39,
      "text": "Birds call once, then leave the quiet whole again.",
      "file": "c039.ogg",
      "durationSec": 5.671
    },
    {
      "index": 40,
      "text": "Breathe in the forest’s freshness.",
      "file": "c040.ogg",
      "durationSec": 3.644
    },
    {
      "index": 41,
      "text": "Breathe out into the patient trunks around you.",
      "file": "c041.ogg",
      "durationSec": 4.75
    },
    {
      "index": 42,
      "text": "Notice how your shoulders have dropped without being asked.",
      "file": "c042.ogg",
      "durationSec": 5.329
    },
    {
      "index": 43,
      "text": "How the jaw softens when there is nowhere else to be.",
      "file": "c043.ogg",
      "durationSec": 5.796
    },
    {
      "index": 44,
      "text": "Stand when you are ready and walk a little farther.",
      "file": "c044.ogg",
      "durationSec": 4.8
    },
    {
      "index": 45,
      "text": "Ferns brush your calves with cool green fingertips.",
      "file": "c045.ogg",
      "durationSec": 5.562
    },
    {
      "index": 46,
      "text": "A clearing opens — round as a held breath.",
      "file": "c046.ogg",
      "durationSec": 4.916
    },
    {
      "index": 47,
      "text": "Lie back on deep moss.",
      "file": "c047.ogg",
      "durationSec": 3.076
    },
    {
      "index": 48,
      "text": "The earth receives your weight completely.",
      "file": "c048.ogg",
      "durationSec": 4.103
    },
    {
      "index": 49,
      "text": "Warmth of filtered sun on your face.",
      "file": "c049.ogg",
      "durationSec": 4.107
    },
    {
      "index": 50,
      "text": "Coolness of moss along your spine.",
      "file": "c050.ogg",
      "durationSec": 4.005
    },
    {
      "index": 51,
      "text": "The breeze arrives, leaves, arrives again.",
      "file": "c051.ogg",
      "durationSec": 4.868
    },
    {
      "index": 52,
      "text": "Stay with the feeling of being held by a living place.",
      "file": "c052.ogg",
      "durationSec": 5.384
    },
    {
      "index": 53,
      "text": "Safe. Quiet. Belonging without effort.",
      "file": "c053.ogg",
      "durationSec": 4.403
    },
    {
      "index": 54,
      "text": "Count five slow breaths here, each one softer.",
      "file": "c054.ogg",
      "durationSec": 5.501
    },
    {
      "index": 55,
      "text": "Notice scent again — green, damp, honest.",
      "file": "c055.ogg",
      "durationSec": 5.496
    },
    {
      "index": 56,
      "text": "Notice sound again — almost none, and that is plenty.",
      "file": "c056.ogg",
      "durationSec": 6.139
    },
    {
      "index": 57,
      "text": "If a thought appears, let it drift like a leaf on the stream.",
      "file": "c057.ogg",
      "durationSec": 6.079
    },
    {
      "index": 58,
      "text": "Return to warmth on the skin wherever the sun finds you.",
      "file": "c058.ogg",
      "durationSec": 5.793
    },
    {
      "index": 59,
      "text": "Return to coolness in the shade between those warm ribbons.",
      "file": "c059.ogg",
      "durationSec": 6.014
    },
    {
      "index": 60,
      "text": "You have walked far enough inward.",
      "file": "c060.ogg",
      "durationSec": 3.473
    },
    {
      "index": 61,
      "text": "Let three slow breaths seal this in the body.",
      "file": "c061.ogg",
      "durationSec": 5.497
    },
    {
      "index": 62,
      "text": "Before you leave, stand once more at the stream.",
      "file": "c062.ogg",
      "durationSec": 5.439
    },
    {
      "index": 63,
      "text": "Watch clear water braid around stones.",
      "file": "c063.ogg",
      "durationSec": 4.629
    },
    {
      "index": 64,
      "text": "Cool air rises from the moving surface.",
      "file": "c064.ogg",
      "durationSec": 4.804
    },
    {
      "index": 65,
      "text": "Warm light still finds a strip of your forearm.",
      "file": "c065.ogg",
      "durationSec": 5.034
    },
    {
      "index": 66,
      "text": "Cup water and wet the brow if you like — in imagination, cool and kind.",
      "file": "c066.ogg",
      "durationSec": 9.162
    },
    {
      "index": 67,
      "text": "The forest does not applaud. It simply continues.",
      "file": "c067.ogg",
      "durationSec": 5.843
    },
    {
      "index": 68,
      "text": "That continuance is a teacher.",
      "file": "c068.ogg",
      "durationSec": 3.524
    },
    {
      "index": 69,
      "text": "Walk the path outward a few quiet steps in the mind.",
      "file": "c069.ogg",
      "durationSec": 6.195
    },
    {
      "index": 70,
      "text": "Needles underfoot. Soft sound. Soft return.",
      "file": "c070.ogg",
      "durationSec": 5.667
    },
    {
      "index": 71,
      "text": "Yet the clearing’s peace stays in the chest like stored sun.",
      "file": "c071.ogg",
      "durationSec": 6.49
    },
    {
      "index": 72,
      "text": "Feel it there — warmth behind the sternum.",
      "file": "c072.ogg",
      "durationSec": 4.802
    },
    {
      "index": 73,
      "text": "Feel freshness still at the nostrils.",
      "file": "c073.ogg",
      "durationSec": 4.052
    },
    {
      "index": 74,
      "text": "You can bring both into ordinary rooms.",
      "file": "c074.ogg",
      "durationSec": 4.449
    },
    {
      "index": 75,
      "text": "One last look up through branches to a coin of sky.",
      "file": "c075.ogg",
      "durationSec": 5.912
    },
    {
      "index": 76,
      "text": "Enough.",
      "file": "c076.ogg",
      "durationSec": 1.317
    },
    {
      "index": 77,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c077.ogg",
      "durationSec": 5.68
    },
    {
      "index": 78,
      "text": "Inhale the freshness of this place.",
      "file": "c078.ogg",
      "durationSec": 3.877
    },
    {
      "index": 79,
      "text": "Exhale into its warmth and quiet.",
      "file": "c079.ogg",
      "durationSec": 4.057
    },
    {
      "index": 80,
      "text": "Inhale.",
      "file": "c080.ogg",
      "durationSec": 1.491
    },
    {
      "index": 81,
      "text": "Exhale.",
      "file": "c081.ogg",
      "durationSec": 1.265
    },
    {
      "index": 82,
      "text": "Again. Soft inhale.",
      "file": "c082.ogg",
      "durationSec": 3.064
    },
    {
      "index": 83,
      "text": "Longer exhale.",
      "file": "c083.ogg",
      "durationSec": 2.014
    },
    {
      "index": 84,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c084.ogg",
      "durationSec": 5.848
    },
    {
      "index": 85,
      "text": "Inhale.",
      "file": "c085.ogg",
      "durationSec": 1.2
    },
    {
      "index": 86,
      "text": "Exhale.",
      "file": "c086.ogg",
      "durationSec": 1.555
    },
    {
      "index": 87,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c087.ogg",
      "durationSec": 5.216
    },
    {
      "index": 88,
      "text": "Or to cool air at the nose.",
      "file": "c088.ogg",
      "durationSec": 3.358
    },
    {
      "index": 89,
      "text": "Inhale.",
      "file": "c089.ogg",
      "durationSec": 1.553
    },
    {
      "index": 90,
      "text": "Exhale.",
      "file": "c090.ogg",
      "durationSec": 1.323
    },
    {
      "index": 91,
      "text": "Inhale.",
      "file": "c091.ogg",
      "durationSec": 1.201
    },
    {
      "index": 92,
      "text": "Exhale.",
      "file": "c092.ogg",
      "durationSec": 1.607
    },
    {
      "index": 93,
      "text": "Stay. Soften. Continue.",
      "file": "c093.ogg",
      "durationSec": 3.521
    },
    {
      "index": 94,
      "text": "Inhale.",
      "file": "c094.ogg",
      "durationSec": 1.501
    },
    {
      "index": 95,
      "text": "Exhale.",
      "file": "c095.ogg",
      "durationSec": 1.322
    },
    {
      "index": 96,
      "text": "One more easy cycle.",
      "file": "c096.ogg",
      "durationSec": 2.939
    },
    {
      "index": 97,
      "text": "Inhale.",
      "file": "c097.ogg",
      "durationSec": 1.553
    },
    {
      "index": 98,
      "text": "Exhale.",
      "file": "c098.ogg",
      "durationSec": 1.438
    },
    {
      "index": 99,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c099.ogg",
      "durationSec": 4.519
    },
    {
      "index": 100,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c100.ogg",
      "durationSec": 4.1
    },
    {
      "index": 101,
      "text": "You can return to this place whenever you need it.",
      "file": "c101.ogg",
      "durationSec": 4.449
    },
    {
      "index": 102,
      "text": "It lives in your attention, not only in imagination.",
      "file": "c102.ogg",
      "durationSec": 5.502
    },
    {
      "index": 103,
      "text": "Begin to deepen the breath.",
      "file": "c103.ogg",
      "durationSec": 2.886
    },
    {
      "index": 104,
      "text": "Feel the room around you again.",
      "file": "c104.ogg",
      "durationSec": 3.458
    },
    {
      "index": 105,
      "text": "Wiggle the fingers. Soften the toes.",
      "file": "c105.ogg",
      "durationSec": 4.456
    },
    {
      "index": 106,
      "text": "When you are ready, open your eyes.",
      "file": "c106.ogg",
      "durationSec": 4.108
    },
    {
      "index": 107,
      "text": "Take one more easy breath.",
      "file": "c107.ogg",
      "durationSec": 3.066
    },
    {
      "index": 108,
      "text": "Carry this calm into whatever comes next.",
      "file": "c108.ogg",
      "durationSec": 4.678
    }
  ],
  "engine": "elevenlabs",
  "elevenVoice": "JBFqnCBsd6RMkjVDRZzb",
