{
  "id": "evening-wind-down",
  "voiceId": "en-gb-ryan",
  "edgeVoice": "en-GB-RyanNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 91,
  "chunks": [
    {
      "index": 0,
      "text": "This practice is for the end of the day.",
      "file": "c000.ogg",
      "durationSec": 3.992
    },
    {
      "index": 1,
      "text": "Dim the lights if you can.",
      "file": "c001.ogg",
      "durationSec": 2.829
    },
    {
      "index": 2,
      "text": "Lie down or recline with support.",
      "file": "c002.ogg",
      "durationSec": 3.985
    },
    {
      "index": 3,
      "text": "Let the day be finished, even if the mind still lists tasks.",
      "file": "c003.ogg",
      "durationSec": 6.831
    },
    {
      "index": 4,
      "text": "You can set them down for now.",
      "file": "c004.ogg",
      "durationSec": 3.233
    },
    {
      "index": 5,
      "text": "Inhale softly for a count of four.",
      "file": "c005.ogg",
      "durationSec": 3.938
    },
    {
      "index": 6,
      "text": "Exhale for a count of six.",
      "file": "c006.ogg",
      "durationSec": 3.234
    },
    {
      "index": 7,
      "text": "Again. Four in. Six out.",
      "file": "c007.ogg",
      "durationSec": 3.877
    },
    {
      "index": 8,
      "text": "Longer exhales tell the body it is safe to rest.",
      "file": "c008.ogg",
      "durationSec": 5.797
    },
    {
      "index": 9,
      "text": "Scan for leftover tension in the face.",
      "file": "c009.ogg",
      "durationSec": 4.402
    },
    {
      "index": 10,
      "text": "Soften the brow. Soften the jaw.",
      "file": "c010.ogg",
      "durationSec": 4.338
    },
    {
      "index": 11,
      "text": "Drop the shoulders away from the ears.",
      "file": "c011.ogg",
      "durationSec": 3.76
    },
    {
      "index": 12,
      "text": "Imagine the day settling like dust after a breeze.",
      "file": "c012.ogg",
      "durationSec": 5.612
    },
    {
      "index": 13,
      "text": "What happened, happened.",
      "file": "c013.ogg",
      "durationSec": 2.539
    },
    {
      "index": 14,
      "text": "What remains can wait until morning.",
      "file": "c014.ogg",
      "durationSec": 3.992
    },
    {
      "index": 15,
      "text": "Feel the mattress or the floor holding you.",
      "file": "c015.ogg",
      "durationSec": 4.572
    },
    {
      "index": 16,
      "text": "Breath quieter. Body heavier.",
      "file": "c016.ogg",
      "durationSec": 3.871
    },
    {
      "index": 17,
      "text": "If sleep comes, let it.",
      "file": "c017.ogg",
      "durationSec": 3.111
    },
    {
      "index": 18,
      "text": "If not, rest in this softness anyway.",
      "file": "c018.ogg",
      "durationSec": 4.282
    },
    {
      "index": 19,
      "text": "Three more slow breaths.",
      "file": "c019.ogg",
      "durationSec": 2.83
    },
    {
      "index": 20,
      "text": "In. Out.",
      "file": "c020.ogg",
      "durationSec": 1.846
    },
    {
      "index": 21,
      "text": "In. Out.",
      "file": "c021.ogg",
      "durationSec": 1.9
    },
    {
      "index": 22,
      "text": "In. Out.",
      "file": "c022.ogg",
      "durationSec": 2.076
    },
    {
      "index": 23,
      "text": "Good night to the day. Peace to the night.",
      "file": "c023.ogg",
      "durationSec": 4.219
    }
  ],
