{
  "id": "canyon-gold-10",
  "voiceId": "en-gb-ryan",
  "edgeVoice": "en-GB-RyanNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 451,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.388
    },
    {
      "index": 1,
      "text": "Find a posture that asks nothing of you.",
      "file": "c001.ogg",
      "durationSec": 4.454
    },
    {
      "index": 2,
      "text": "Sit, or lie down, with whatever support you need.",
      "file": "c002.ogg",
      "durationSec": 5.793
    },
    {
      "index": 3,
      "text": "Let your hands rest open or soft.",
      "file": "c003.ogg",
      "durationSec": 4.397
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 5.442
    },
    {
      "index": 5,
      "text": "Feel the places where your body meets the ground.",
      "file": "c005.ogg",
      "durationSec": 5.154
    },
    {
      "index": 6,
      "text": "The heels, the sit bones, the back of the head, or the length of the spine.",
      "file": "c006.ogg",
      "durationSec": 7.879
    },
    {
      "index": 7,
      "text": "Nothing to hold up right now.",
      "file": "c007.ogg",
      "durationSec": 2.83
    },
    {
      "index": 8,
      "text": "Take a slow breath in through the nose.",
      "file": "c008.ogg",
      "durationSec": 4.167
    },
    {
      "index": 9,
      "text": "Feel the coolness of the air arriving.",
      "file": "c009.ogg",
      "durationSec": 4.389
    },
    {
      "index": 10,
      "text": "And breathe out a little longer.",
      "file": "c010.ogg",
      "durationSec": 3.18
    },
    {
      "index": 11,
      "text": "Feel the warmth of the exhale leaving.",
      "file": "c011.ogg",
      "durationSec": 4.456
    },
    {
      "index": 12,
      "text": "Again. Soft inhale.",
      "file": "c012.ogg",
      "durationSec": 3.066
    },
    {
      "index": 13,
      "text": "Unhurried exhale.",
      "file": "c013.ogg",
      "durationSec": 2.537
    },
    {
      "index": 14,
      "text": "Let the shoulders drop a fraction.",
      "file": "c014.ogg",
      "durationSec": 3.405
    },
    {
      "index": 15,
      "text": "Let the jaw unclench.",
      "file": "c015.ogg",
      "durationSec": 2.846
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 2.545
    },
    {
      "index": 17,
      "text": "Stay with three quiet breaths, just as they are.",
      "file": "c017.ogg",
      "durationSec": 5.558
    },
    {
      "index": 18,
      "text": "Inhale. Arrive.",
      "file": "c018.ogg",
      "durationSec": 2.48
    },
    {
      "index": 19,
      "text": "Exhale. Settle.",
      "file": "c019.ogg",
      "durationSec": 2.541
    },
    {
      "index": 20,
      "text": "If the mind wanders, notice it kindly, and come back to this breath.",
      "file": "c020.ogg",
      "durationSec": 7.241
    },
    {
      "index": 21,
      "text": "Imagine a wide canyon painted in soft gold and rose.",
      "file": "c021.ogg",
      "durationSec": 6.486
    },
    {
      "index": 22,
      "text": "It is late afternoon. The light is generous.",
      "file": "c022.ogg",
      "durationSec": 4.92
    },
    {
      "index": 23,
      "text": "Warmth radiates from stone that has held the sun all day.",
      "file": "c023.ogg",
      "durationSec": 6.197
    },
    {
      "index": 24,
      "text": "Feel that radiant heat on your shins and the backs of your hands.",
      "file": "c024.ogg",
      "durationSec": 6.718
    },
    {
      "index": 25,
      "text": "A dry, fresh breeze moves down the canyon floor.",
      "file": "c025.ogg",
      "durationSec": 5.609
    },
    {
      "index": 26,
      "text": "It cools your face without taking the comfort of the warmth.",
      "file": "c026.ogg",
      "durationSec": 5.734
    },
    {
      "index": 27,
      "text": "You walk a sandy path between quiet walls.",
      "file": "c027.ogg",
      "durationSec": 4.919
    },
    {
      "index": 28,
      "text": "Footsteps whisper. Echoes are soft, almost polite.",
      "file": "c028.ogg",
      "durationSec": 6.49
    },
    {
      "index": 29,
      "text": "Smell sunbaked earth, sage, and clean dust.",
      "file": "c029.ogg",
      "durationSec": 5.613
    },
    {
      "index": 30,
      "text": "Place your palm on smooth stone.",
      "file": "c030.ogg",
      "durationSec": 3.875
    },
    {
      "index": 31,
      "text": "Feel stored daylight there — steady, patient heat.",
      "file": "c031.ogg",
      "durationSec": 5.849
    },
    {
      "index": 32,
      "text": "A ribbon of shade offers coolness for a few steps.",
      "file": "c032.ogg",
      "durationSec": 5.335
    },
    {
      "index": 33,
      "text": "Then sun again, warm across your shoulders like a shawl.",
      "file": "c033.ogg",
      "durationSec": 5.906
    },
    {
      "index": 34,
      "text": "You come to a place where the canyon opens.",
      "file": "c034.ogg",
      "durationSec": 4.451
    },
    {
      "index": 35,
      "text": "Sit on a flat rock still holding golden warmth.",
      "file": "c035.ogg",
      "durationSec": 5.562
    },
    {
      "index": 36,
      "text": "Feel it rise through your seat and spine.",
      "file": "c036.ogg",
      "durationSec": 4.333
    },
    {
      "index": 37,
      "text": "Feel the fresher air of altitude in every inhale.",
      "file": "c037.ogg",
      "durationSec": 5.965
    },
    {
      "index": 38,
      "text": "Far above, a hawk turns slow circles without hurry.",
      "file": "c038.ogg",
      "durationSec": 6.315
    },
    {
      "index": 39,
      "text": "You borrow that unhurried quality.",
      "file": "c039.ogg",
      "durationSec": 3.936
    },
    {
      "index": 40,
      "text": "Breath long. Body heavy. Mind wide as the sky between walls.",
      "file": "c040.ogg",
      "durationSec": 8.288
    },
    {
      "index": 41,
      "text": "Watch shadow climb the far cliff as the sun lowers.",
      "file": "c041.ogg",
      "durationSec": 5.964
    },
    {
      "index": 42,
      "text": "Colors deepen. Warmth softens but does not vanish.",
      "file": "c042.ogg",
      "durationSec": 5.913
    },
    {
      "index": 43,
      "text": "The breeze smells cooler now, evening-fresh.",
      "file": "c043.ogg",
      "durationSec": 5.037
    },
    {
      "index": 44,
      "text": "Wrap your arms around yourself for a moment.",
      "file": "c044.ogg",
      "durationSec": 4.338
    },
    {
      "index": 45,
      "text": "Warmth of your own body. Warmth of stone. Enough.",
      "file": "c045.ogg",
      "durationSec": 5.959
    },
    {
      "index": 46,
      "text": "Lie back carefully and watch the first quiet star.",
      "file": "c046.ogg",
      "durationSec": 5.672
    },
    {
      "index": 47,
      "text": "The canyon holds you the way a cupped hand holds water — gently, without spill.",
      "file": "c047.ogg",
      "durationSec": 8.584
    },
    {
      "index": 48,
      "text": "Rest in that held feeling.",
      "file": "c048.ogg",
      "durationSec": 3.055
    },
    {
      "index": 49,
      "text": "Notice the last heat rising from rock into the cooling air.",
      "file": "c049.ogg",
      "durationSec": 6.263
    },
    {
      "index": 50,
      "text": "Notice how the breeze now smells of evening and dust and sage.",
      "file": "c050.ogg",
      "durationSec": 6.949
    },
    {
      "index": 51,
      "text": "Your breath has slowed to match the wide quiet.",
      "file": "c051.ogg",
      "durationSec": 4.986
    },
    {
      "index": 52,
      "text": "If tension remains in the brow, soften it in this gold light.",
      "file": "c052.ogg",
      "durationSec": 6.429
    },
    {
      "index": 53,
      "text": "If the jaw is tight, let it hang loose as the hawk’s easy turn.",
      "file": "c053.ogg",
      "durationSec": 6.835
    },
    {
      "index": 54,
      "text": "Stay for a few more cycles of warm stone and fresh air.",
      "file": "c054.ogg",
      "durationSec": 6.138
    },
    {
      "index": 55,
      "text": "You are not late. You are here.",
      "file": "c055.ogg",
      "durationSec": 3.642
    },
    {
      "index": 56,
      "text": "Walk a few more steps along warm sand between canyon walls.",
      "file": "c056.ogg",
      "durationSec": 7.125
    },
    {
      "index": 57,
      "text": "Your shadow stretches long and unworried.",
      "file": "c057.ogg",
      "durationSec": 4.396
    },
    {
      "index": 58,
      "text": "Place both palms on stone again.",
      "file": "c058.ogg",
      "durationSec": 3.824
    },
    {
      "index": 59,
      "text": "Heat enters the hands like a blessing you do not have to earn.",
      "file": "c059.ogg",
      "durationSec": 5.847
    },
    {
      "index": 60,
      "text": "The breeze combs coolness through your hair.",
      "file": "c060.ogg",
      "durationSec": 4.799
    },
    {
      "index": 61,
      "text": "Sage scent. Dust scent. Sun scent.",
      "file": "c061.ogg",
      "durationSec": 5.149
    },
    {
      "index": 62,
      "text": "Sit. Knees soft. Spine easy.",
      "file": "c062.ogg",
      "durationSec": 4.167
    },
    {
      "index": 63,
      "text": "Watch color deepen from gold toward rose.",
      "file": "c063.ogg",
      "durationSec": 5.147
    },
    {
      "index": 64,
      "text": "Warmth softens. Freshness increases. Balance remains.",
      "file": "c064.ogg",
      "durationSec": 7.028
    },
    {
      "index": 65,
      "text": "This is how evenings teach the nervous system to downshift.",
      "file": "c065.ogg",
      "durationSec": 6.023
    },
    {
      "index": 66,
      "text": "Borrow the lesson without effort.",
      "file": "c066.ogg",
      "durationSec": 3.351
    },
    {
      "index": 67,
      "text": "Three breaths for the stone.",
      "file": "c067.ogg",
      "durationSec": 3.116
    },
    {
      "index": 68,
      "text": "Three for the sky.",
      "file": "c068.ogg",
      "durationSec": 2.248
    },
    {
      "index": 69,
      "text": "Three for the quiet animal of your own body, resting.",
      "file": "c069.ogg",
      "durationSec": 5.843
    },
    {
      "index": 70,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c070.ogg",
      "durationSec": 5.618
    },
    {
      "index": 71,
      "text": "Inhale the freshness of this place.",
      "file": "c071.ogg",
      "durationSec": 3.588
    },
    {
      "index": 72,
      "text": "Exhale into its warmth and quiet.",
      "file": "c072.ogg",
      "durationSec": 4.108
    },
    {
      "index": 73,
      "text": "Inhale.",
      "file": "c073.ogg",
      "durationSec": 1.485
    },
    {
      "index": 74,
      "text": "Exhale.",
      "file": "c074.ogg",
      "durationSec": 1.497
    },
    {
      "index": 75,
      "text": "Again. Soft inhale.",
      "file": "c075.ogg",
      "durationSec": 3.057
    },
    {
      "index": 76,
      "text": "Longer exhale.",
      "file": "c076.ogg",
      "durationSec": 2.368
    },
    {
      "index": 77,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c077.ogg",
      "durationSec": 5.963
    },
    {
      "index": 78,
      "text": "Inhale.",
      "file": "c078.ogg",
      "durationSec": 1.553
    },
    {
      "index": 79,
      "text": "Exhale.",
      "file": "c079.ogg",
      "durationSec": 1.258
    },
    {
      "index": 80,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c080.ogg",
      "durationSec": 5.558
    },
    {
      "index": 81,
      "text": "Or to cool air at the nose.",
      "file": "c081.ogg",
      "durationSec": 3.227
    },
    {
      "index": 82,
      "text": "Inhale.",
      "file": "c082.ogg",
      "durationSec": 1.492
    },
    {
      "index": 83,
      "text": "Exhale.",
      "file": "c083.ogg",
      "durationSec": 1.606
    },
    {
      "index": 84,
      "text": "Inhale.",
      "file": "c084.ogg",
      "durationSec": 1.496
    },
    {
      "index": 85,
      "text": "Exhale.",
      "file": "c085.ogg",
      "durationSec": 1.614
    },
    {
      "index": 86,
      "text": "Stay. Soften. Continue.",
      "file": "c086.ogg",
      "durationSec": 3.286
    },
    {
      "index": 87,
      "text": "Inhale.",
      "file": "c087.ogg",
      "durationSec": 1.437
    },
    {
      "index": 88,
      "text": "Exhale.",
      "file": "c088.ogg",
      "durationSec": 1.485
    },
    {
      "index": 89,
      "text": "One more easy cycle.",
      "file": "c089.ogg",
      "durationSec": 2.951
    },
    {
      "index": 90,
      "text": "Inhale.",
      "file": "c090.ogg",
      "durationSec": 1.602
    },
    {
      "index": 91,
      "text": "Exhale.",
      "file": "c091.ogg",
      "durationSec": 1.614
    },
    {
      "index": 92,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c092.ogg",
      "durationSec": 4.804
    },
    {
      "index": 93,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c093.ogg",
      "durationSec": 4.219
    },
    {
      "index": 94,
      "text": "You can return to this place whenever you need it.",
      "file": "c094.ogg",
      "durationSec": 4.57
    },
    {
      "index": 95,
      "text": "It lives in your attention, not only in imagination.",
      "file": "c095.ogg",
      "durationSec": 5.501
    },
    {
      "index": 96,
      "text": "Begin to deepen the breath.",
      "file": "c096.ogg",
      "durationSec": 2.826
    },
    {
      "index": 97,
      "text": "Feel the room around you again.",
      "file": "c097.ogg",
      "durationSec": 3.593
    },
    {
      "index": 98,
      "text": "Wiggle the fingers. Soften the toes.",
      "file": "c098.ogg",
      "durationSec": 4.336
    },
    {
      "index": 99,
      "text": "When you are ready, open your eyes.",
      "file": "c099.ogg",
      "durationSec": 3.823
    },
    {
      "index": 100,
      "text": "Take one more easy breath.",
      "file": "c100.ogg",
      "durationSec": 3.059
    },
    {
      "index": 101,
      "text": "Carry this calm into whatever comes next.",
      "file": "c101.ogg",
      "durationSec": 4.682
    }
  ],
