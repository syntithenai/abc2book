      "silence": true
    },
    {
      "index": 95,
      "text": "Take a deeper breath in.",
      "file": "c095.ogg",
      "durationSec": 2.713
    },
    {
      "index": 96,
      "text": "And a long sigh out.",
      "file": "c096.ogg",
      "durationSec": 2.713
    },
    {
      "index": 97,
      "text": "When you are ready, open the eyes.",
      "file": "c097.ogg",
      "durationSec": 3.637
    },
    {
      "index": 98,
      "text": "Return slowly.",
      "file": "c098.ogg",
      "durationSec": 2.304
    },
    {
      "index": 99,
      "text": "Carry a little of this quiet with you.",
