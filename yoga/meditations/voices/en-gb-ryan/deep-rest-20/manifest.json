    {
      "index": 76,
      "text": "Nothing to solve.",
      "file": "c076.ogg",
      "durationSec": 2.245
    },
    {
      "index": 77,
      "text": "Nothing to complete.",
      "file": "c077.ogg",
      "durationSec": 2.364
    },
    {
      "index": 78,
      "text": "[pause:110]",
      "file": "c078.ogg",
      "durationSec": 110.0,
      "silence": true
    },
    {
      "index": 79,
      "text": "If you drift, that is fine.",
      "file": "c079.ogg",
      "durationSec": 3.294
    },
    {
      "index": 80,
      "text": "If you stay aware, that is fine too.",
      "file": "c080.ogg",
      "durationSec": 4.511
    },
    {
      "index": 81,
      "text": "Both are rest.",
      "file": "c081.ogg",
      "durationSec": 2.129
    },
    {
      "index": 82,
      "text": "[pause:130]",
      "file": "c082.ogg",
      "durationSec": 130.0,
      "silence": true
    },
    {
      "index": 83,
      "text": "Rest.",
      "file": "c083.ogg",
      "durationSec": 1.386
    },
    {
      "index": 84,
      "text": "[pause:115]",
      "file": "c084.ogg",
      "durationSec": 115.0,
      "silence": true
    },
    {
      "index": 85,
      "text": "Begin to notice the breath again.",
      "file": "c085.ogg",
      "durationSec": 3.412
    },
    {
      "index": 86,
      "text": "A little more vivid now.",
      "file": "c086.ogg",
      "durationSec": 2.716
    },
    {
      "index": 87,
      "text": "[pause:23]",
      "file": "c087.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 88,
      "text": "Feel the room around you.",
      "file": "c088.ogg",
      "durationSec": 2.777
    },
    {
      "index": 89,
