    },
    {
      "index": 68,
      "text": "[pause:105]",
      "file": "c068.ogg",
      "durationSec": 105.0,
      "silence": true
    },
    {
      "index": 69,
      "text": "Soft. Spacious. Still.",
      "file": "c069.ogg",
      "durationSec": 3.59
