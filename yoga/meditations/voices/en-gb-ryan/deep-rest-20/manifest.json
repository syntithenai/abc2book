    {
      "index": 70,
      "text": "[pause:55]",
      "file": "c070.ogg",
      "durationSec": 55.0,
      "silence": true
    },
    {
      "index": 71,
      "text": "If a thought appears, let it pass like a cloud.",
      "file": "c071.ogg",
      "durationSec": 5.092
    },
    {
      "index": 72,
      "text": "[pause:50]",
      "file": "c072.ogg",
      "durationSec": 50.0,
      "silence": true
    },
    {
      "index": 73,
      "text": "Return to the feeling of being held.",
      "file": "c073.ogg",
      "durationSec": 3.94
    },
    {
      "index": 74,
      "text": "[pause:55]",
      "file": "c074.ogg",
      "durationSec": 55.0,
      "silence": true
    },
    {
      "index": 75,
      "text": "Rest here.",
      "file": "c075.ogg",
      "durationSec": 1.55
