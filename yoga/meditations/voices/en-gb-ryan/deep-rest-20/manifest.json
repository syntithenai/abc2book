  "chunks": [
    {
      "index": 0,
      "text": "Welcome to a practice of deep rest.",
      "file": "c000.ogg",
      "durationSec": 4.166
    },
    {
      "index": 1,
      "text": "Lie on your back if you can.",
      "file": "c001.ogg",
      "durationSec": 3.011
    },
    {
      "index": 2,
      "text": "Support the head and knees if that helps.",
      "file": "c002.ogg",
      "durationSec": 4.22
    },
    {
      "index": 3,
      "text": "Let the arms rest by your sides, palms soft.",
      "file": "c003.ogg",
      "durationSec": 5.326
    },
    {
      "index": 4,
      "text": "Close the eyes.",
      "file": "c004.ogg",
      "durationSec": 2.131
    },
    {
      "index": 5,
      "text": "There is nowhere else to be.",
      "file": "c005.ogg",
      "durationSec": 2.83
    },
    {
      "index": 6,
      "text": "[pause:23]",
      "file": "c006.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 7,
      "text": "Feel the points of contact with the floor or bed.",
      "file": "c007.ogg",
      "durationSec": 5.083
    },
    {
      "index": 8,
      "text": "Heels. Hips. Shoulder blades. Head.",
      "file": "c008.ogg",
      "durationSec": 4.46
    },
    {
      "index": 9,
      "text": "Allow the body to be held.",
      "file": "c009.ogg",
      "durationSec": 3.011
    },
    {
      "index": 10,
      "text": "[pause:23]",
      "file": "c010.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 11,
      "text": "Notice the natural breath.",
      "file": "c011.ogg",
      "durationSec": 2.944
    },
    {
      "index": 12,
      "text": "No need to change it.",
      "file": "c012.ogg",
      "durationSec": 2.366
    },
    {
      "index": 13,
      "text": "Inhale arrives.",
      "file": "c013.ogg",
      "durationSec": 2.195
    },
    {
      "index": 14,
      "text": "Exhale leaves.",
      "file": "c014.ogg",
      "durationSec": 2.195
    },
    {
      "index": 15,
      "text": "[pause:25]",
      "file": "c015.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "If the mind is busy, that is allowed.",
      "file": "c016.ogg",
      "durationSec": 4.169
    },
    {
      "index": 17,
      "text": "You can rest anyway.",
      "file": "c017.ogg",
      "durationSec": 2.54
    },
    {
      "index": 18,
      "text": "Simply keep returning to sensation.",
      "file": "c018.ogg",
      "durationSec": 4.052
    },
    {
      "index": 19,
      "text": "[pause:23]",
      "file": "c019.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 20,
      "text": "Bring awareness to the right foot.",
      "file": "c020.ogg",
      "durationSec": 3.404
    },
    {
      "index": 21,
      "text": "Toes. Sole. Heel.",
