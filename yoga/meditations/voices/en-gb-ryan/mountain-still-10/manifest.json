    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 2.616
    },
    {
      "index": 9,
      "text": "[pause:28]",
      "file": "c009.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 3.696
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
