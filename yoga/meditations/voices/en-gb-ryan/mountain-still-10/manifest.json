      "durationSec": 57.0,
      "silence": true
    },
    {
      "index": 20,
      "text": "Thoughts and moods are weather.",
      "file": "c020.ogg",
      "durationSec": 4.248
    },
    {
      "index": 21,
      "text": "You are the mountain.",
