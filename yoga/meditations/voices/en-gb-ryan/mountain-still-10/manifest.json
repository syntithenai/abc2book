      "text": "[pause:36]",
      "file": "c012.ogg",
      "durationSec": 36.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Imagine yourself as a mountain.",
      "file": "c013.ogg",
      "durationSec": 4.56
    },
    {
      "index": 14,
      "text": "Base wide. Peak quiet. Vast patience.",
      "file": "c014.ogg",
      "durationSec": 9.696
    },
    {
      "index": 15,
      "text": "[pause:43]",
      "file": "c015.ogg",
      "durationSec": 43.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Weather moves across the mountain.",
      "file": "c016.ogg",
      "durationSec": 4.536
    },
    {
      "index": 17,
      "text": "Sun. Wind. Cloud. Storm.",
      "file": "c017.ogg",
      "durationSec": 8.688
    },
    {
      "index": 18,
      "text": "The mountain remains.",
