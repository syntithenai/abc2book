    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 4.488
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 3.384
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
