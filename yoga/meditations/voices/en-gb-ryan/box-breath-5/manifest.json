    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 2.76
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 7.104
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 3.648
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 4.896
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 3.744
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 3.912
    },
    {
      "index": 6,
      "text": "We will breathe in a simple box.",
      "file": "c006.ogg",
      "durationSec": 4.752
    },
    {
      "index": 7,
      "text": "In for four. Hold for four. Out for four. Hold for four.",
      "file": "c007.ogg",
      "durationSec": 12.048
    },
    {
      "index": 8,
      "text": "Stay gentle. Never strain.",
      "file": "c008.ogg",
      "durationSec": 6.312
    },
    {
      "index": 9,
      "text": "[pause:20]",
      "file": "c009.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Inhale. Two. Three. Four.",
      "file": "c010.ogg",
      "durationSec": 9.936
    },
    {
      "index": 11,
      "text": "Hold. Two. Three. Four.",
      "file": "c011.ogg",
      "durationSec": 9.672
    },
    {
      "index": 12,
      "text": "Exhale. Two. Three. Four.",
      "file": "c012.ogg",
      "durationSec": 9.888
    },
    {
      "index": 13,
      "text": "Hold. Two. Three. Four.",
      "file": "c013.ogg",
