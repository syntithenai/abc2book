      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Again. Inhale.",
      "file": "c015.ogg",
      "durationSec": 5.376
    },
    {
      "index": 16,
      "text": "Hold.",
      "file": "c016.ogg",
      "durationSec": 2.64
    },
    {
      "index": 17,
      "text": "Exhale.",
