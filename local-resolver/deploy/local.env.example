# Snippet for laptop dev (local-resolver/.env or docker-compose.dev.yml).
# npm start proxies API paths to localhost:8787.
REQUIRE_AUTH=false
# Optional: test with auth
# REQUIRE_AUTH=true
# RESOLVER_ACCESS_EMAILS=your@gmail.com
# Billing is always on Cloud Run — do not enable a local ledger unless isolating billing tests
BILLING_ENABLED=false
# Stripe keys are NOT needed locally; buy credit via SPA → Cloud Run checkout
