# Snippet for peppertrees home resolver (.env on the home machine).
# Full template: ../.env.example
#
# Peppertrees = fat resolver (Whisper, Demucs, Snapcast, Cast). NOT the billing ledger.
REQUIRE_AUTH=true
ALLOWED_ORIGINS=https://tunebook.net,https://www.tunebook.net,http://localhost:3000,http://127.0.0.1:3000
FREE_ACCESS_EMAILS=your@gmail.com
EMBEDDED_CREDS_EMAILS=your@gmail.com
# OAuth BFF (SQLite on ./data volume)
GOOGLE_CLIENT_SECRET=...
AUTH_SESSION_SECRET=...
AUTH_SESSION_DB_PATH=/app/data/oauth_sessions.sqlite
# No Stripe / billing on home — ledger is on Cloud Run
BILLING_ENABLED=false
CAST_PUBLIC_URL=https://peppertrees.syntithenai.com
SNAPCAST_PUBLIC_URL=https://peppertrees.syntithenai.com/snapcast
