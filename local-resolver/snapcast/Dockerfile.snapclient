# Local snapclient for the resolver host (profile: snapcast).
# Installs the same Snapcast release family as ghcr.io/badaix/snapserver.

ARG SNAPCAST_VERSION=0.35.0
FROM debian:bookworm-slim

ARG SNAPCAST_VERSION
ARG TARGETARCH

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && case "$TARGETARCH" in \
    amd64) deb_arch="amd64" ;; \
    arm64) deb_arch="arm64" ;; \
    arm) deb_arch="armhf" ;; \
    *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
  esac \
  && deb="snapclient_${SNAPCAST_VERSION}-1_${deb_arch}_bookworm_with-pipewire.deb" \
  && curl -fsSL "https://github.com/badaix/snapcast/releases/download/v${SNAPCAST_VERSION}/${deb}" -o "/tmp/${deb}" \
  && apt-get install -y "/tmp/${deb}" \
  && rm -rf /var/lib/apt/lists/* "/tmp/${deb}"

COPY snapclient-entrypoint.sh /usr/local/bin/snapclient-entrypoint.sh
RUN chmod +x /usr/local/bin/snapclient-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/snapclient-entrypoint.sh"]
