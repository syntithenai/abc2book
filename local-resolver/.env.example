# Copy to .env and edit.
# GOOGLE_CLIENT_ID is required when REQUIRE_AUTH=true (same OAuth client as the tunebook app).

GOOGLE_CLIENT_ID=
# Client secret for OAuth BFF (authorization-code exchange + silent refresh).
# Never ship this to the SPA. Only set on trusted resolvers that should advertise
# features.oauthBff / oauthBff. Public resolvers may omit it (oauthBff stays false;
# the SPA then keeps today's Token Client login, including the hourly popup).
# GOOGLE_CLIENT_SECRET=
# Random secret (32+ bytes) required together with GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
# for oauthBff. Used to gate the BFF feature; session ids are opaque random tokens.
# AUTH_SESSION_SECRET=
# SQLite path for OAuth refresh-token sessions (created automatically).
# AUTH_SESSION_DB_PATH=./data/oauth_sessions.sqlite
# Optional Fernet key to encrypt refresh tokens at rest (recommended on shared hosts).
# AUTH_REFRESH_TOKEN_FERNET_KEY=
# Set true to require Google login (production and docker-compose.dev.yml).
REQUIRE_AUTH=false
# Comma-separated Google account emails allowed to use the resolver when REQUIRE_AUTH=true.
# Does NOT block OAuth BFF login / Drive token exchange — only media endpoints when REQUIRE_AUTH=true.
# Example public deployment:
# ALLOWED_EMAILS=stavia3000@gmail.com,syntithenai@gmail.com
ALLOWED_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787,https://tunebook.net,http://tunebook.net

# Google Cloud Console checklist (SPA origins only — not resolver callback URLs):
# 1. Authorized JavaScript origins: https://tunebook.net, http://localhost:3000, http://127.0.0.1:3000
# 2. Authorized redirect URIs: same SPA origins (GIS Code Client popup mode uses page origin)
# 3. Deploy GOOGLE_CLIENT_SECRET + AUTH_SESSION_SECRET only on trusted oauthBff resolvers
# 4. First login after enabling BFF may need prompt=consent once to obtain a refresh_token

# Host directory mounted read-only at /models for whisper.cpp lyrics transcription.
# Default (when unset): local-resolver/whisper/models — create it and place ggml-large-v3.bin there.
# WHISPER_MODELS_DIR=./whisper/models
# Override with an absolute path if your models live elsewhere, e.g.:
# WHISPER_MODELS_DIR=/path/to/whisper models

# Serve the built tunebook site plus local ABC/soundfont resources from the resolver.
# In Docker, docker-compose.yml mounts the project root at /app/www and sets STATIC_SITE_DIR.
# STATIC_SITE_ENABLED=auto turns this on when index.html is present (default).
# STATIC_SITE_DIR=/app/www
# STATIC_SITE_ENABLED=auto

# Optional server-side GoatCounter analytics for resolver endpoint usage.
# Create an API key in GoatCounter and point this at the same site as the web app.
# Events are sent with no_sessions=true and only coarse paths like resolver-server/transcribe.
# GOATCOUNTER_API_URL=https://abc2book.goatcounter.com/api/v0/count
# GOATCOUNTER_API_TOKEN=
# GOATCOUNTER_TIMEOUT_SECONDS=5
WHISPER_TIMEOUT_SECONDS=600
WHISPER_BACKEND_PREFERENCE=auto
WHISPER_CPU_FALLBACK=true
WHISPER_CPP_BEST_OF=5
WHISPER_CPP_BEAM_SIZE=5
WHISPER_LANGUAGE=en
WHISPER_WORD_TIMESTAMPS=true
WHISPER_CPP_NO_CONTEXT=false
WHISPER_LYRICS_FORMAT=true
WHISPER_LYRICS_MAX_WORDS=10
WHISPER_LYRICS_LINE_PAUSE_SECONDS=1.2
WHISPER_LYRICS_STANZA_PAUSE_SECONDS=4.0
# Melody analysis (Demucs + CREPE + madmom timing). CPU build is default.
# MELODY_BACKEND_PREFERENCE=auto
# MELODY_BACKEND=auto
# MELODY_BACKEND=basic-pitch
# MELODY_SOURCE_SEPARATION=auto
# CHORD_CONSTRAIN_TO_KEY=true
# CHORD_MIN_DURATION_SECONDS=0.35
# CHORD_MEDIAN_WINDOW=3
# MELODY_CONFIDENCE_THRESHOLD=0.55
# MELODY_MIN_NOTE_SECONDS=0.12
# MELODY_CREPE_MODEL=medium
# MELODY_DEMUCS_MODEL=htdemucs
# MELODY_DEMUCS_MODEL=htdemucs_6s
# Max concurrent CPU/GPU-heavy subprocess jobs (whisper, demucs, autochord, vision).
# Duplicate stem requests for the same source are still coalesced automatically.
# MAX_CONCURRENT_HEAVY_JOBS=2
# SUBPROCESS_KILL_GRACE_SECONDS=5
# FFMPEG_TIMEOUT_SECONDS=120
# YTDLP_TIMEOUT_SECONDS=300
# UPSTREAM_FETCH_TIMEOUT_SECONDS=120
# GPU resolver (requires NVIDIA Container Toolkit):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile gpu up --build
# Optional CUDA wheel index when building the GPU image:
# MELODY_TORCH_INDEX=https://download.pytorch.org/whl/cu121
# MAX_MIDI_IMPORT_BYTES=4194304

# HTTPS reverse proxy (docker compose --profile https up). Required so the
# production HTTPS site can reach this resolver without mixed-content errors.
# RESOLVER_DOMAIN must have public DNS pointing at this machine and ports
# 80/443 open so Caddy can obtain a Let's Encrypt certificate.
# RESOLVER_DOMAIN=peppertrees.syntithenai.com
# ACME_EMAIL=you@example.com
# Host ports for Caddy. You can use HTTPS_PORT=8443 and then configure the app
# resolver URL as https://your-domain.example:8443. Public Let's Encrypt certs
# still require either port 80/443 access or DNS challenge configuration.
# HTTP_PORT=80
# HTTPS_PORT=443

# Namecheap dynamic DNS (docker compose --profile ddns up -d). Keeps your
# host's DNS record pointed at this machine's changing home IP. Enable Dynamic
# DNS on the domain in Namecheap (Domain List -> Manage -> Advanced DNS ->
# Dynamic DNS) and paste the generated Dynamic DNS Password below (this is NOT
# your Namecheap account password). For peppertrees.syntithenai.com, set
# NAMECHEAP_DDNS_DOMAIN=syntithenai.com and NAMECHEAP_DDNS_HOSTS=peppertrees.
# NAMECHEAP_DDNS_DOMAIN=syntithenai.com
# NAMECHEAP_DDNS_HOSTS=peppertrees
# NAMECHEAP_DDNS_PASSWORD=
# NAMECHEAP_DDNS_INTERVAL=300
# NAMECHEAP_DDNS_IP_LOOKUP_URLS=https://ipv4.icanhazip.com,https://api.ipify.org,https://checkip.amazonaws.com
# Force a Namecheap update every N successful cycles, even when the detected
# public IP has not changed. This helps self-heal stale DNS records.
# NAMECHEAP_DDNS_FORCE_INTERVAL=12

# Tune background research (web search + LLM summarization)
# RESEARCH_SEARCH_BACKEND=duckduckgo
# RESEARCH_SEARCH_BACKEND=brave
# BRAVE_SEARCH_API_KEY=
# SEARXNG_BASE_URL=http://localhost:8080
# SERPER_API_KEY=
# RESEARCH_SEARCH_TIMEOUT_SECONDS=20
# RESEARCH_LLM_BASE_URL=http://host.docker.internal:12340/v1
# Point at the compose llm-gateway (:12340). It prefers the in-compose llm
# service (:12341 / llama.cpp) and falls back to host LM Studio (:1234).
# RESEARCH_LLM_MODEL=google/gemma-4-31b-qat
# RESEARCH_LLM_API_KEY=lm-studio
# RESEARCH_LLM_TIMEOUT_SECONDS=120
#
# In-compose OpenAI-compatible LLM (Vulkan llama.cpp). Defaults to the same
# Gemma GGUF directory LM Studio uses.
# LLM_MODELS_DIR=/home/YOU/.lmstudio/models/lmstudio-community/gemma-4-31B-it-QAT-GGUF
# LLM_MODEL_FILENAME=gemma-4-31B-it-QAT-Q4_0.gguf
# LLM_PUBLISH_PORT=12341
# LLM_FALLBACK_PORT=1234
# LLM_CTX_SIZE=8192
# LLM_N_GPU_LAYERS=99
# Optional multimodal projector (sheet-image VLM); leave empty for text-only.
# LLM_MMPROJ_FILE=/models/mmproj-gemma-4-31B-it-QAT-BF16.gguf
#
# If set, the llm container does NOT load a GGUF — it reverse-proxies this
# OpenAI-compatible base URL. Include /v1 when the upstream uses it
# (e.g. https://api.openai.com/v1); request paths are de-duplicated.
# LLM_EXTERNAL_BASE_URL=https://api.openai.com/v1
# Upstream Bearer token for external proxy mode (OpenAI, OpenRouter, etc.).
# Separate from RESEARCH_LLM_API_KEY, which authenticates app → gateway → local llm.
# LLM_EXTERNAL_API_KEY=
#
# Generous LLM container logging (prompts + reasoning in docker logs).
# LLM_LOG_TRAFFIC=true
# LLM_LOG_VERBOSE=true
# LLM_LOG_BODY_CHARS=50000
# LLM_REASONING_FORMAT=deepseek
# RESEARCH_TARGET_WORDS=800
# RESEARCH_MIN_WORDS=700
# RESEARCH_MAX_WORDS=950
# RESEARCH_LLM_MAX_TOKENS=2800
# RESEARCH_MAX_SOURCES_IN_PROMPT=80
# RESEARCH_MAX_SNIPPET_CHARS=1200
# RESEARCH_SEARCH_RESULTS_PER_QUERY=5
# RESEARCH_MAX_SUPPLEMENTAL_QUERIES=4
# RESEARCH_MIN_SOURCES_BEFORE_SKIP_SUPPLEMENTAL=12
# RESEARCH_SEARCH_QUERY_CONCURRENCY=3
# RESEARCH_SUPPLEMENTAL_QUERY_LLM_MAX_TOKENS=600
# RESEARCH_MAX_LYRICS_CHARS=8000

# Voice commands (POST /voice-command). Falls back to RESEARCH_LLM_* when unset.
# VOICE_COMMAND_LLM_BASE_URL=
# VOICE_COMMAND_LLM_MODEL=
# VOICE_COMMAND_LLM_API_KEY=
# VOICE_COMMAND_LLM_TIMEOUT_SECONDS=30
# VOICE_COMMAND_LLM_MAX_TOKENS=300
# VOICE_COMMAND_WHISPER_PROMPT=Voice commands show search open go to find filter book tag artist.

# Granular resolver capabilities reported by GET /health in the "features" object.
# Disable individual services on hosts that cannot run them (e.g. no GPU/CPU for Demucs).
# PROXY_ENABLED=true
# STEMS_ENABLED=true
# WHISPER_ENABLED=true
# LLM_ENABLED=true
# LLM_HEALTH_CACHE_SECONDS=60

# Sheet image import (PaddleOCR + homr OMR in /opt/vision-venv by default).
# SHEET_IMAGE_ENABLED=true
# SHEET_IMAGE_OCR_ENABLED=true
# SHEET_IMAGE_OMR_ENABLED=true
# SHEET_IMAGE_VLM_ENABLED=true
# SHEET_IMAGE_VLM_CONFIDENCE_THRESHOLD=0.55
# SHEET_IMAGE_TIMEOUT_SECONDS=900
# SHEET_IMAGE_MAX_EDGE=2400
# MAX_SHEET_IMAGE_BYTES=20971520
# VISION_VENV_PYTHON=/opt/vision-venv/bin/python
# VISION_CACHE_ROOT=/opt/vision-cache
# PADDLE_PDX_CACHE_HOME=/opt/vision-cache

# Chord search can also use BRAVE_SEARCH_API_KEY to discover supported chord
# pages when direct slug URLs miss. It falls back to slug URLs/external links
# when this is unset.
# CHORD_SEARCH_RESULTS_PER_QUERY=8

# Polite scrape layer (lyrics/chords/notation page fetches).
# POLITE_FETCH_PER_HOST=2
# POLITE_FETCH_GLOBAL=4
# POLITE_FETCH_JITTER_MS_MIN=150
# POLITE_FETCH_JITTER_MS_MAX=400
# POLITE_FETCH_MAX_RETRIES=2

# Playwright Chromium fallback after polite httpx fails (soft JS walls only).
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_TIMEOUT_MS=20000
