# Copy to .env and edit.
# GOOGLE_CLIENT_ID is required when REQUIRE_AUTH=true (same OAuth client as the tunebook app).

GOOGLE_CLIENT_ID=
REQUIRE_AUTH=false
# Comma-separated Google account emails allowed to use the resolver when REQUIRE_AUTH=true.
# Example public deployment:
# ALLOWED_EMAILS=stavia3000@gmail.com,syntithenai@gmail.com
ALLOWED_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tunebook.net,http://tunebook.net
WHISPER_TIMEOUT_SECONDS=600
WHISPER_BACKEND_PREFERENCE=auto
WHISPER_CPU_FALLBACK=true
WHISPER_CPP_BEST_OF=1
WHISPER_CPP_NO_CONTEXT=false
