# Copy to .env and edit.
# GOOGLE_CLIENT_ID is required when REQUIRE_AUTH=true (same OAuth client as the tunebook app).

GOOGLE_CLIENT_ID=
# Client secret for OAuth BFF (authorization-code exchange + silent refresh).
# Never ship this to the SPA. Only set on trusted resolvers that should advertise
# features.oauthBff / oauthBff. Public resolvers may omit it (oauthBff stays false;
# the SPA then keeps today's Token Client login, including the hourly popup).
# GOOGLE_CLIENT_SECRET=
# Random secret (32+ bytes) required together with GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
# for oauthBff. Used to gate the BFF feature; session ids are opaque random tokens.
# AUTH_SESSION_SECRET=
# SQLite path for OAuth refresh-token sessions (created automatically).
# On peppertrees with docker-compose, use /app/data/oauth_sessions.sqlite (./data volume).
# AUTH_SESSION_DB_PATH=/app/data/oauth_sessions.sqlite
# Cloud Run: use Firestore instead of SQLite (see CLOUD_RUN.md).
# AUTH_SESSION_STORE=firestore
# AUTH_SESSION_FIRESTORE_PROJECT=abc2book
# AUTH_SESSION_FIRESTORE_COLLECTION=oauth_sessions
# AUTH_REFRESH_MIN_INTERVAL_SECONDS=45 — minimum seconds between Google token refreshes per session.
# AUTH_ACCESS_TOKEN_CACHE_SKEW_SECONDS=60 — return cached access token when it expires later than this.
# Set true to require Google login (production and docker-compose.dev.yml).
REQUIRE_AUTH=false
# Who may use this resolver host when REQUIRE_AUTH=true. Empty = any signed-in Google user. Token ALL = everyone.
# RESOLVER_ACCESS_EMAILS=stavia3000@gmail.com,syntithenai@gmail.com
RESOLVER_ACCESS_EMAILS=
# Admin-only UI features (feed feedback, billing admin panel).
# ALLOWED_ADMIN_EMAILS=stever@syntithenai.com
ALLOWED_ADMIN_EMAILS=

# Admin GitHub publish (POST /admin/github/publish-book) — never expose to the SPA.
# GITHUB_TOKEN=ghp_...
# GITHUB_PUBLISH_REPO=syntithenai/abc2book
# GITHUB_PUBLISH_BRANCH=main
# GITHUB_PUBLISH_SCRAPE_PREFIX=scrape

# Credit billing (hosted resolver prepaid usage). When enabled, users need positive balance
# for embedded provider keys and proxied media egress (resolver access still required).
# BILLING_ENABLED defaults false on full resolver; true on Cloud Run (RESOLVER_LIGHT_MODE) unless set.
# BILLING_MARKUP=2.0
# TRIAL_CREDIT_CENTS=30
# BILLING_DB_PATH=/app/data/billing.sqlite
# BILLING_STORE=sqlite
# BILLING_FIRESTORE_PROJECT=abc2book
# BILLING_FIRESTORE_COLLECTION=billing_accounts
# BILLING_LEDGER_COLLECTION=billing_ledger
# BILLING_STRIPE_EVENTS_COLLECTION=billing_stripe_events
# BILLING_PAYMENT_EVENTS_COLLECTION=billing_payment_events
# Stripe Checkout (credit top-ups). Central ledger + webhook live on Cloud Run only.
# Hosted service: https://tunebook-resolver-light-ytrp5enyda-ts.a.run.app
# Live checklist:
#   - Dashboard → Payment methods: Cards, Google Pay, Apple Pay
#   - Dashboard → Payment method domains: tunebook.net (required for wallet buttons)
#   - Webhook (live): https://tunebook-resolver-light-ytrp5enyda-ts.a.run.app/billing/webhook
#     event checkout.session.completed
# The SPA routes all /billing/* API calls to Cloud Run (not peppertrees or localhost).
# Home peppertrees + local resolver: set BILLING_ENABLED=false (no local ledger).
# Cloud Run: set BILLING_ENABLED=true and Stripe secrets there.
# 1. Stripe Dashboard → Developers → API keys → copy Secret key → STRIPE_SECRET_KEY (on Cloud Run)
# 2. Developers → Webhooks → Add endpoint → URL https://tunebook-resolver-light-ytrp5enyda-ts.a.run.app/billing/webhook
#    Event: checkout.session.completed → copy Signing secret → STRIPE_WEBHOOK_SECRET
# 3. Test locally: stripe listen --forward-to localhost:8787/billing/webhook (only when testing webhook handler locally)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Default return URLs when the SPA does not pass success_url/cancel_url:
# BILLING_CHECKOUT_SUCCESS_URL=https://tunebook.net/#/billing/success?session_id={CHECKOUT_SESSION_ID}
# BILLING_CHECKOUT_CANCEL_URL=https://tunebook.net/#/billing/cancel
# Allowed SPA origins for checkout return URLs (comma-separated). The SPA sends the current origin.
# BILLING_CHECKOUT_ALLOWED_RETURN_ORIGINS=https://tunebook.net,http://localhost:3000
# Payment method hints returned by GET /billing/balance (SPA copy). Wallets appear on Checkout
# when enabled in the Stripe Dashboard and tunebook.net is registered as a payment method domain.
# BILLING_STRIPE_CARDS_ENABLED=true
# BILLING_STRIPE_GOOGLE_PAY_ENABLED=true
# BILLING_STRIPE_APPLE_PAY_ENABLED=true
# PayPal via Stripe Custom Payment Method (AU). See PAYPAL_CPM.md — blocked until Stripe approves.
# PAYPAL_CPM_ENABLED=false
# PAYPAL_CPM_ADAPTER_URL=http://paypal-cpm:8080
# PAYPAL_CPM_PAYMENT_METHOD_CONFIGURATION=pmc_...
# Local dev (npm start + resolver on :8787):
# BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/#/billing/success?session_id={CHECKOUT_SESSION_ID}
# BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/#/billing/cancel
# Credit holds (reservations) — conservative pre-flight estimates; TTL for orphaned holds.
# BILLING_RESERVATIONS_ENABLED=true
# BILLING_HOLD_TTL_SECONDS=600
# Flat job costs (millicents upstream; markup applied at billing).
# BILLING_PRACTICE_TRACK_JOB_COST_MILLICENTS=500
# BILLING_LINKED_COVER_JOB_COST_MILLICENTS=500
# TTS speech (flat per call + egress for request/response bytes).
# BILLING_TTS_SPEECH_FLAT_COST_MILLICENTS=20
# BYO API key proxy (flat fee per proxied call + egress; user pays upstream separately).
# BILLING_API_PROXY_LLM_FLAT_MILLICENTS=5
# BILLING_API_PROXY_WHISPER_FLAT_MILLICENTS=5
# BILLING_API_PROXY_OCR_FLAT_MILLICENTS=5
# BILLING_API_PROXY_STEMS_FLAT_MILLICENTS=10

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787,https://tunebook.net,http://tunebook.net

# Cloud ML providers (optional). When set, home or Cloud Run can run Whisper/LLM/OCR via APIs
# instead of (or as fallback after) local models. Used when the caller has resolver access
# or when REQUIRE_AUTH=false. Users can still overlay their own keys from Settings → Providers.
# PROVIDER_LLM_PROVIDER=groq
# PROVIDER_LLM_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_LLM_API_KEY=
# PROVIDER_LLM_MODEL=llama-3.1-8b-instant
# PROVIDER_WHISPER_PROVIDER=groq
# PROVIDER_WHISPER_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_WHISPER_API_KEY=
# PROVIDER_WHISPER_MODEL=whisper-large-v3
# PROVIDER_OCR_PROVIDER=openai
# PROVIDER_OCR_BASE_URL=https://api.openai.com/v1
# PROVIDER_OCR_API_KEY=
# PROVIDER_OCR_MODEL=gpt-4o-mini
# PROVIDER_STEMS_PROVIDER=fal
# PROVIDER_STEMS_BASE_URL=https://fal.run
# PROVIDER_STEMS_API_KEY=
# PROVIDER_STEMS_MODEL=htdemucs

# Slim Cloud Run / light gateway mode: disable local Whisper/Demucs/OCR/OMR; use providers only.
# RESOLVER_LIGHT_MODE=false
# YTDLP_PROXY=http://user:pass@residential-proxy:port
# Optional dedicated HTML scrape egress (Ultimate Guitar etc.). Falls back to YTDLP_PROXY.
# SCRAPE_PROXY=http://user:pass@residential-proxy:port
# YTDLP_REQUIRE_USER_PROXY=false
# HEAVY_JOB_QUEUE_TIMEOUT_SECONDS=120
# MAX_CONCURRENT_HEAVY_JOBS=2

# Production HTTPS: expose only Caddy on port 443 (do not publish :8787 publicly).
# See README "Single-port HTTPS" and docker compose profile `https`.

# Google Cloud Console checklist (SPA origins only — not resolver callback URLs):
# 1. Authorized JavaScript origins: https://tunebook.net, http://localhost:3000, http://127.0.0.1:3000
# 2. Authorized redirect URIs: same SPA origins (GIS Code Client popup mode uses page origin)
# 3. Deploy GOOGLE_CLIENT_SECRET + AUTH_SESSION_SECRET only on trusted oauthBff resolvers
# 4. First login after enabling BFF may need prompt=consent once to obtain a refresh_token

# Host directory mounted read-only at /models for whisper.cpp lyrics transcription.
# Default (when unset): local-resolver/whisper/models — create it and place ggml-large-v3.bin there.
# WHISPER_MODELS_DIR=./whisper/models
# Override with an absolute path if your models live elsewhere, e.g.:
# WHISPER_MODELS_DIR=/path/to/whisper models

# Serve the built tunebook site plus local ABC/soundfont resources from the resolver.
# In Docker, docker-compose.yml mounts the project root at /static/www and sets STATIC_SITE_DIR.
# STATIC_SITE_ENABLED=auto turns this on when index.html is present (default).
# STATIC_SITE_DIR=/static/www
# STATIC_SITE_ENABLED=auto

# MusyngKite GM soundfonts (~1GB). On startup the resolver downloads the full bank
# once into this Docker volume (skip if already complete). Served at
# /midi-js-soundfonts/MusyngKite/ with embedded selection/abcjs preferred when present.
# SOUNDFONT_HOST_DIR=./soundfonts
# SOUNDFONT_DIR=/soundfonts
# SOUNDFONT_DOWNLOAD_ENABLED=true
# SOUNDFONT_DOWNLOAD_CONCURRENCY=6
# SOUNDFONT_SOURCE_BASE=https://paulrosen.github.io/midi-js-soundfonts/MusyngKite

# Local MIDI library (sibling repo abc2book_midi_resources). Mount into Docker and
# build the search index once with:
#   python3 scripts/build_midi_resources_index.py /path/to/abc2book_midi_resources
# MIDI_RESOURCES_HOST_DIR=../../abc2book_midi_resources
# MIDI_RESOURCES_DIR=/midi-resources

# Local ABC dumps (repo abcresources/ + textsearch_index.json). Already available in
# Docker via the /static/www mount. Optional overrides:
# ABC2BOOK_ROOT=/static/www
# ABC_RESOURCES_DIR=/static/www/abcresources
# ABC_TEXTSEARCH_INDEX=/static/www/textsearch_index.json
# ABC_CONTOUR_INDEX=/app/data/abc_contour_index.json
# ABC_CONTOUR_AUTOBUILD=false
# Build contour index for OMR melody matching:
#   python3 scripts/build_abc_contour_index.py
#   docker exec -w /app abc2book-local-resolver python3 /static/www/local-resolver/scripts/build_abc_contour_index.py

# Personal music collection (MP3/FLAC/etc.). Mount into Docker and build index:
#   python3 scripts/build_music_collection_index.py /path/to/music-collection
# MUSIC_COLLECTION_HOST_DIR=./music-collection
# MUSIC_COLLECTION_DIR=/music-collection
# MUSIC_COLLECTION_INDEX_DIR=/app/data/music-collection
# MUSIC_COLLECTION_EMAILS=syntithenai@gmail.com
# MUSIC_COLLECTION_FILE_TIMEOUT_SECONDS=8
# MUSIC_COLLECTION_CHECKPOINT_EVERY=2000
# MUSIC_COLLECTION_MAX_ERROR_LOG=500
# MUSIC_COLLECTION_SKIP_SYMLINKS=1

# Folk/trad media search (Internet Archive, Europeana, Library of Congress)
# INTERNET_ARCHIVE_ENABLED=true
# LOC_AUDIO_ENABLED=true
# Europeana Sounds — free API key from https://www.europeana.eu/en/developers/registration
# EUROPEANA_API_KEY=

# Optional server-side GoatCounter analytics for resolver endpoint usage.
# Create an API key in GoatCounter and point this at the same site as the web app.
# Events are sent with no_sessions=true and only coarse paths like resolver-server/transcribe.
# GOATCOUNTER_API_URL=https://abc2book.goatcounter.com/api/v0/count
# GOATCOUNTER_API_TOKEN=
# GOATCOUNTER_TIMEOUT_SECONDS=5
WHISPER_TIMEOUT_SECONDS=600
WHISPER_BACKEND_PREFERENCE=auto
WHISPER_CPU_FALLBACK=true
WHISPER_CPP_BEST_OF=5
WHISPER_CPP_BEAM_SIZE=5
WHISPER_LANGUAGE=en
WHISPER_WORD_TIMESTAMPS=true
WHISPER_CPP_NO_CONTEXT=false
WHISPER_LYRICS_FORMAT=true
WHISPER_LYRICS_MAX_WORDS=10
WHISPER_LYRICS_LINE_PAUSE_SECONDS=1.2
WHISPER_LYRICS_STANZA_PAUSE_SECONDS=4.0
# Melody analysis (Demucs + CREPE + madmom timing). CPU build is default.
# MELODY_BACKEND_PREFERENCE=auto
# MELODY_BACKEND=auto
# MELODY_BACKEND=basic-pitch
# MELODY_BACKEND=kong
# MELODY_BACKEND=mt3
# KONG_CHECKPOINT_PATH=/opt/kong-piano/note_F1=0.9677_pedal_F1=0.9186.pth
# MELODY_AMT_PROVIDER=  # set to replicate for cloud fallback when local Kong/MT3 missing
# MELODY_MT3_MODEL=yourmt3
# MELODY_SOURCE_SEPARATION=auto
# Chord recognition: auto tries BTC, then madmom, then autochord.
# CHORD_BACKEND=auto
# CHORD_BACKEND=btc
# CHORD_BACKEND=madmom
# CHORD_BACKEND=autochord
# BTC_MODEL_DIR=/opt/btc-chords
# BTC_CHECKPOINT_PATH=
# CHORD_CONSTRAIN_TO_KEY=true
# CHORD_MIN_DURATION_SECONDS=0.35
# CHORD_MEDIAN_WINDOW=3
# CHORD_CHANGE_GRID=half-bar
# CHORD_CHANGE_PENALTY=true
# STEM_CACHE_DIR=/tmp/stem-cache
# Practice track generation (notation melody + AI backing). mock works without audio.cpp.
# PRACTICE_TRACK_ENABLED=true
# PRACTICE_TRACK_PROVIDER=audio_cpp
# Practice track generation (AI backing via audio.cpp Vulkan sidecar on host)
# PRACTICE_TRACK_ENABLED=true
# PRACTICE_TRACK_PROVIDER=audio_cpp
# In-compose sidecar: docker compose --profile audio-cpp up  and  AUDIO_CPP_URL=http://audio-cpp:8788
# Host-managed sidecar instead: AUDIO_CPP_URL=http://host.docker.internal:8788
# AUDIO_CPP_HOST_DIR=${HOME}/audio.cpp
# Shared WAV staging for linked-cover / guide audio (required when resolver and audio.cpp use different filesystems):
# AUDIO_CPP_INPUT_DIR=/audio-cpp-incoming
# AUDIO_CPP_INPUT_API_PATH=${HOME}/audio.cpp/incoming
# AUDIO_CPP_MODEL_ID=stable-audio-3-small-music
# PRACTICE_TRACK_CACHE_DIR=/tmp/practice-track-cache
# Unified audio generation API (/generate-audio): practice_track + linked_cover tasks.
# Preset picks model per request; install AceStep for linked cover:
#   cd ~/audio.cpp && python3 tools/model_manager.py install ace_step
# AUDIO_GEN_COORDINATION_REQUIRED=true
# AUDIO_CPP_IDLE_UNLOAD_SECONDS=300
# AUDIO_CPP_IDLE_SUPERVISOR_ENABLED=true
# MELODY_CONFIDENCE_THRESHOLD=0.55
# MELODY_MIN_NOTE_SECONDS=0.12
# MELODY_CREPE_MODEL=medium
# MELODY_DEMUCS_MODEL=htdemucs
# MELODY_DEMUCS_MODEL=htdemucs_6s
# Max concurrent CPU/GPU-heavy subprocess jobs (whisper, demucs, autochord, vision).
# Duplicate stem requests for the same source are still coalesced automatically.
# MAX_CONCURRENT_HEAVY_JOBS=2
# SUBPROCESS_KILL_GRACE_SECONDS=5
# FFMPEG_TIMEOUT_SECONDS=120
# YTDLP_TIMEOUT_SECONDS=300
# UPSTREAM_FETCH_TIMEOUT_SECONDS=120
# GPU resolver (requires NVIDIA Container Toolkit):
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile gpu up --build
# Optional CUDA wheel index when building the GPU image:
# MELODY_TORCH_INDEX=https://download.pytorch.org/whl/cu121
# MAX_MIDI_IMPORT_BYTES=4194304

# HTTPS reverse proxy (docker compose --profile https up). Required so the
# production HTTPS site can reach this resolver without mixed-content errors.
# RESOLVER_DOMAIN must have public DNS pointing at this machine and ports
# 80/443 open so Caddy can obtain a Let's Encrypt certificate.
# RESOLVER_DOMAIN=peppertrees.syntithenai.com
# ACME_EMAIL=you@example.com
# Host ports for Caddy. You can use HTTPS_PORT=8443 and then configure the app
# resolver URL as https://your-domain.example:8443. Public Let's Encrypt certs
# still require either port 80/443 access or DNS challenge configuration.
# HTTP_PORT=80
# HTTPS_PORT=443

# Namecheap dynamic DNS (docker compose --profile ddns up -d). Keeps your
# host's DNS record pointed at this machine's changing home IP. Enable Dynamic
# DNS on the domain in Namecheap (Domain List -> Manage -> Advanced DNS ->
# Dynamic DNS) and paste the generated Dynamic DNS Password below (this is NOT
# your Namecheap account password). For peppertrees.syntithenai.com, set
# NAMECHEAP_DDNS_DOMAIN=syntithenai.com and NAMECHEAP_DDNS_HOSTS=peppertrees.
# NAMECHEAP_DDNS_DOMAIN=syntithenai.com
# NAMECHEAP_DDNS_HOSTS=peppertrees
# NAMECHEAP_DDNS_PASSWORD=
# NAMECHEAP_DDNS_INTERVAL=300
# NAMECHEAP_DDNS_IP_LOOKUP_URLS=https://ipv4.icanhazip.com,https://api.ipify.org,https://checkip.amazonaws.com
# Force a Namecheap update every N successful cycles, even when the detected
# public IP has not changed. This helps self-heal stale DNS records.
# NAMECHEAP_DDNS_FORCE_INTERVAL=12

# Tune background research (web search + LLM summarization)
# RESEARCH_SEARCH_BACKEND=duckduckgo
# RESEARCH_SEARCH_BACKEND=brave
# BRAVE_SEARCH_API_KEY=
# SEARXNG_BASE_URL=http://localhost:8080
# SERPER_API_KEY=
# RESEARCH_SEARCH_TIMEOUT_SECONDS=20
# RESEARCH_LLM_BASE_URL=http://host.docker.internal:12340/v1
# Point at the compose llm-gateway (:12340). Default primary is host
# qwen-proxy (127.0.0.1:8081, model qwen3.8-off). Optional in-compose Gemma
# llama.cpp is profile `gemma-llm` (docker compose --profile gemma-llm up -d).
# RESEARCH_LLM_MODEL=qwen3.8-off
# RESEARCH_LLM_API_KEY=
# RESEARCH_LLM_TIMEOUT_SECONDS=120
# RESEARCH_LLM_MAX_TOKENS=2048
# LLM_PRIMARY_BASE_URL=http://127.0.0.1:8081
# LLM_FALLBACK_BASE_URL=
#
# Optional in-compose Gemma GGUF (only with --profile gemma-llm):
# LLM_MODELS_DIR=/home/YOU/.lmstudio/models/lmstudio-community/gemma-4-31B-it-QAT-GGUF
# LLM_MODEL_FILENAME=gemma-4-31B-it-QAT-Q4_0.gguf
# LLM_PUBLISH_PORT=12341
# LLM_FALLBACK_PORT=1234
# LLM_CTX_SIZE=8192
# LLM_N_GPU_LAYERS=99
# Optional multimodal projector (sheet-image VLM); leave empty for text-only.
# LLM_MMPROJ_FILE=/models/mmproj-gemma-4-31B-it-QAT-BF16.gguf
#
# If set, the llm container does NOT load a GGUF — it reverse-proxies this
# OpenAI-compatible base URL. Include /v1 when the upstream uses it
# (e.g. https://api.openai.com/v1); request paths are de-duplicated.
# LLM_EXTERNAL_BASE_URL=https://api.openai.com/v1
# Upstream Bearer token for external proxy mode (OpenAI, OpenRouter, etc.).
# Separate from RESEARCH_LLM_API_KEY, which authenticates app → gateway → local llm.
# LLM_EXTERNAL_API_KEY=
#
# Generous LLM container logging (prompts + reasoning in docker logs).
# LLM_LOG_TRAFFIC=true
# LLM_LOG_VERBOSE=true
# LLM_LOG_BODY_CHARS=50000
# LLM_REASONING_FORMAT=deepseek
# RESEARCH_TARGET_WORDS=800
# RESEARCH_MIN_WORDS=700
# RESEARCH_MAX_WORDS=950
# RESEARCH_LLM_MAX_TOKENS=2800
# RESEARCH_MAX_SOURCES_IN_PROMPT=80
# RESEARCH_MAX_SNIPPET_CHARS=1200
# RESEARCH_SEARCH_RESULTS_PER_QUERY=5
# RESEARCH_MAX_SUPPLEMENTAL_QUERIES=4
# RESEARCH_MIN_SOURCES_BEFORE_SKIP_SUPPLEMENTAL=12
# RESEARCH_SEARCH_QUERY_CONCURRENCY=3
# RESEARCH_SUPPLEMENTAL_QUERY_LLM_MAX_TOKENS=600
# RESEARCH_MAX_LYRICS_CHARS=8000

# Voice commands (POST /voice-command). Falls back to RESEARCH_LLM_* when unset.
# VOICE_COMMAND_LLM_BASE_URL=
# VOICE_COMMAND_LLM_MODEL=
# VOICE_COMMAND_LLM_API_KEY=
# VOICE_COMMAND_LLM_TIMEOUT_SECONDS=30
# VOICE_COMMAND_LLM_MAX_TOKENS=300
# VOICE_COMMAND_WHISPER_PROMPT=Voice commands show search open go to find filter book tag artist.

# Text-to-speech (Kokoro GPU + Piper CPU + gateway). Enable with:
#   ./scripts/tts-up.sh
# or:
#   docker compose --profile tts up -d --build
#   docker compose --profile tts --profile tts-gpu up -d --build   # AMD ROCm GPU
# Kokoro ROCm image is 10–20 GB; tts-up.sh starts Piper first then pulls GPU.
# TTS_SKIP_GPU=1   # skip Kokoro pull/start even when /dev/kfd exists
# Strix Halo (gfx1151 / Radeon 8060S): tts-up.sh auto-uses Kokoro CPU image (ROCm 6.4 segfaults).
# TTS_KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
# TTS_KOKORO_USE_GPU=false
# TTS_KOKORO_DEVICE=cpu
# HSA_OVERRIDE_GFX_VERSION=11.5.1   # ROCm on kernel 6.19.x (non-Strix Halo AMD)
# HSA_ENABLE_SDMA=0
# TTS_PUBLISH_PORT=8789
# TTS_URL=http://tts-gateway:8789   # required for POST /tts/speech and features.tts
# TTS_VOICE=af_bella
# TTS_PIPER_VOICE=en_US-lessac-medium
# TTS_ENABLED=true

# Granular resolver capabilities reported by GET /health in the "features" object.
# Disable individual services on hosts that cannot run them (e.g. no GPU/CPU for Demucs).
# PROXY_ENABLED=true
# STEMS_ENABLED=true
# WHISPER_ENABLED=true
# LLM_ENABLED=true
# LLM_HEALTH_CACHE_SECONDS=60

# Sheet image import (PaddleOCR + homr OMR in /opt/vision-venv by default).
# SHEET_IMAGE_ENABLED=true
# SHEET_IMAGE_OCR_ENABLED=true
# SHEET_IMAGE_OMR_ENABLED=true
# SHEET_IMAGE_VLM_ENABLED=true
# SHEET_IMAGE_VLM_CONFIDENCE_THRESHOLD=0.55
# SHEET_IMAGE_TIMEOUT_SECONDS=900
# SHEET_IMAGE_MAX_EDGE=2400
# SHEET_IMAGE_DESKEW=true
# SHEET_IMAGE_FLATTEN=true
# MAX_SHEET_IMAGE_BYTES=20971520
# VISION_VENV_PYTHON=/opt/vision-venv/bin/python
# VISION_CACHE_ROOT=/opt/vision-cache
# PADDLE_PDX_CACHE_HOME=/opt/vision-cache

# Chord search can also use BRAVE_SEARCH_API_KEY to discover supported chord
# pages when direct slug URLs miss. It falls back to slug URLs/external links
# when this is unset.
# CHORD_SEARCH_RESULTS_PER_QUERY=8

# Polite scrape layer (lyrics/chords/notation page fetches).
# POLITE_FETCH_PER_HOST=2
# POLITE_FETCH_GLOBAL=4
# POLITE_FETCH_JITTER_MS_MIN=150
# POLITE_FETCH_JITTER_MS_MAX=400
# POLITE_FETCH_MAX_RETRIES=2

# Playwright Chromium fallback after polite httpx fails (soft JS walls only).
# PLAYWRIGHT_ENABLED=true
# PLAYWRIGHT_TIMEOUT_MS=20000

# Snapcast sidecar (docker compose --profile snapcast)
# SNAPCAST_ENABLED=true
# Resolver connects to snapserver PCM port (default for compose sidecar):
# SNAPCAST_TCP_MODE=client
# SNAPCAST_TCP_TARGET=snapserver:4954
# For an external snapserver that connects to the resolver instead:
# SNAPCAST_TCP_MODE=server
# SNAPCAST_TCP_BIND=0.0.0.0:4954
# SNAPCAST_SERVER_HOST=snapserver
# SNAPCAST_STREAM_NAME=TuneBook
# SNAPCAST_PUBLISH_PORT=1780
# SNAPCAST_CLIENT_PORT=1704
# SNAPCLIENT_ENABLED=true
# SNAPCLIENT_HOSTNAME=resolver-host
# SNAPCLIENT_SOUNDCARD=default
# For PipeWire desktops, try SNAPCLIENT_SOUNDCARD=pipewire and mount the socket
# (see local-resolver/snapcast/README.md).
# SNAPCAST_PLUGIN_URL=http://127.0.0.1:8787/snapcast-playback/plugin
# Public HTTPS base when behind Caddy (not wss:// — the app derives wss from this)
# SNAPCAST_PUBLIC_URL=https://peppertrees.example.com/snapcast

# Chromecast HLS sessions (requires ffmpeg; shares transcode with Snapcast)
# Public HTTPS base Chromecast devices fetch from. Defaults to https://RESOLVER_DOMAIN
# (peppertrees.syntithenai.com) so TVs reach your DDNS host, not localhost.
# CAST_PUBLIC_URL=https://peppertrees.syntithenai.com
# CAST_SESSION_DIR=/tmp/abc2book-cast-sessions
# CAST_MAX_SESSIONS=4
# CAST_SESSION_TTL_SECONDS=1800
# CAST_MAX_SESSION_AGE_SECONDS=7200
