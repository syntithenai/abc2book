{
  "manifest_version": 3,
  "name": "TuneBook Helper",
  "version": "0.1.9",
  "description": "Loads audio and soft-blocked pages (e.g. Ultimate Guitar) in your browser so Tunebook can work without a residential resolver.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TuneBook Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "https://tunebook.net/*",
        "https://www.tunebook.net/*",
        "https://*.syntithenai.com/*",
        "http://*.syntithenai.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://*.youtube.com/*",
    "https://tabs.ultimate-guitar.com/*",
    "https://www.ultimate-guitar.com/*",
    "https://ultimate-guitar.com/*"
  ],
  "permissions": ["storage"]
}
